[{"n":"玩法指南","d":"操作、经验、升级、宝箱、建筑、召唤首领以及游魂大军。","u":"/zh-cn/wiki/how-to-play/","c":"Wiki","i":"/assets/icons/characters/bob.png"},{"n":"角色","d":"12 只可玩水豚：属性、初始武器、被动与解锁方式。","u":"/zh-cn/wiki/characters/","c":"Wiki","i":"/assets/icons/characters/caparzo.png"},{"n":"武器","d":"每一种自动武器的效果与解锁方式。","u":"/zh-cn/wiki/weapons/","c":"Wiki","i":"/assets/icons/weapons/fireball.png"},{"n":"本能","d":"升级时可选的 26 种动物本能（被动）。","u":"/zh-cn/wiki/instincts/","c":"Wiki","i":"/assets/icons/instincts/armor_passive.png"},{"n":"道具","d":"按稀有度分类的宝箱与商店道具及其效果。","u":"/zh-cn/wiki/items/","c":"Wiki","i":"/assets/icons/items/lampara_encantada.png"},{"n":"首领","d":"每种攀登中的精英首领、楼层首领、任务首领与最终遭遇战。","u":"/zh-cn/wiki/bosses/","c":"Wiki","i":"/assets/sprites/boss_devorador.png"},{"n":"敌人","d":"各生态的普通敌人及其行为。","u":"/zh-cn/wiki/enemies/","c":"Wiki","i":"/assets/sprites/enemy_eyeball.png"},{"n":"攀登","d":"三种攀登、生态、按时触发的事件、难度与排行榜。","u":"/zh-cn/wiki/tower/","c":"Wiki","i":"/assets/sprites/enemy_sentinel_eye.png"},{"n":"成长与解锁","d":"红宝石、永久属性、解锁链以及完整任务列表。","u":"/zh-cn/wiki/progression/","c":"Wiki","i":"/assets/icons/items/lucky_bag.png"},{"n":"背景故事","d":"Sir Capy Drake 的传说、赤红群峰，以及名为 Capy of Gods 的竞赛。","u":"/zh-cn/wiki/lore/","c":"Wiki","i":"/assets/sprites/boss_capy_demon_king.png"},{"n":"常见问题","d":"抢先体验、价格、平台、语言、直播等等。","u":"/zh-cn/wiki/faq/","c":"Wiki","i":"/assets/brand/favicon.png"},{"n":"Bob","d":"侦探嗅觉","u":"/zh-cn/wiki/characters/#c-bob","c":"角色","i":"/assets/icons/characters/bob.png"},{"n":"C-Rex","d":"原始狂怒","u":"/zh-cn/wiki/characters/#c-c_rex","c":"角色","i":"/assets/icons/characters/c_rex.png"},{"n":"Johnny","d":"硬化甲壳","u":"/zh-cn/wiki/characters/#c-caparzo","c":"角色","i":"/assets/icons/characters/caparzo.png"},{"n":"Capytain Gale","d":"顺风","u":"/zh-cn/wiki/characters/#c-capytain_gale","c":"角色","i":"/assets/icons/characters/capytain_gale.png"},{"n":"Deadeye","d":"致命瞄准","u":"/zh-cn/wiki/characters/#c-deadeye","c":"角色","i":"/assets/icons/characters/deadeye.png"},{"n":"Dr. Plague","d":"灼热高烧","u":"/zh-cn/wiki/characters/#c-dr_peste","c":"角色","i":"/assets/icons/characters/dr_peste.png"},{"n":"Gary","d":"流水线","u":"/zh-cn/wiki/characters/#c-gary","c":"角色","i":"/assets/icons/characters/gary.png"},{"n":"Lycap","d":"嗜血","u":"/zh-cn/wiki/characters/#c-lycap","c":"角色","i":"/assets/icons/characters/lycap.png"},{"n":"Sir Drake Jr.","d":"骑士的骄傲","u":"/zh-cn/wiki/characters/#c-sir_drake_jr","c":"角色","i":"/assets/icons/characters/sir_drake_jr.png"},{"n":"Skelly-san","d":"偶像狂热","u":"/zh-cn/wiki/characters/#c-skelly_san","c":"角色","i":"/assets/icons/characters/skelly_san.png"},{"n":"Sparky","d":"过载","u":"/zh-cn/wiki/characters/#c-sparky","c":"角色","i":"/assets/icons/characters/sparky.png"},{"n":"Stinky","d":"恶臭缠身","u":"/zh-cn/wiki/characters/#c-stinky","c":"角色","i":"/assets/icons/characters/stinky.png"},{"n":"利刃毛皮","d":"竖起的毛发形成光环，伤害靠近的一切","u":"/zh-cn/wiki/weapons/#w-aura","c":"武器","i":"/assets/icons/weapons/aura.png"},{"n":"横扫利爪","d":"朝最近的敌人扇形撕裂。击杀时有 5% 几率回复 1 点生命。","u":"/zh-cn/wiki/weapons/#w-claw_sweep","c":"武器","i":"/assets/icons/weapons/claw_sweep.png"},{"n":"剧毒口水","d":"吐出在敌人之间弹射的毒液弹","u":"/zh-cn/wiki/weapons/#w-escupo","c":"武器","i":"/assets/icons/weapons/escupo.png"},{"n":"炽焰唾沫","d":"发射火球，灼烧怪物","u":"/zh-cn/wiki/weapons/#w-fireball","c":"武器","i":"/assets/icons/weapons/fireball.png"},{"n":"火焰喷射器","d":"喷出一道火焰，转向最近的敌人，可能灼烧扫过的一切","u":"/zh-cn/wiki/weapons/#w-fireground","c":"武器","i":"/assets/icons/weapons/fireground.png"},{"n":"荧光棒","d":"掷出一根荧光棒，减速、掉头并飞回。去程和回程都会造成伤害。","u":"/zh-cn/wiki/weapons/#w-glow_stick","c":"武器","i":"/assets/icons/weapons/glow_stick.png"},{"n":"雷霆线圈","d":"对附近的敌人召唤电击","u":"/zh-cn/wiki/weapons/#w-lightning","c":"武器","i":"/assets/icons/weapons/lightning.png"},{"n":"章鱼哨兵","d":"每 3 秒部署一个章鱼哨兵，存在 5 秒，并以你的属性射击附近的敌人。","u":"/zh-cn/wiki/weapons/#w-octo_sentry","c":"武器","i":"/assets/icons/weapons/octo_sentry.png"},{"n":"狙击步枪","d":"发射穿透弹，贯穿一条直线上的敌人。用鼠标或右摇杆瞄准","u":"/zh-cn/wiki/weapons/#w-sniper","c":"武器","i":"/assets/icons/weapons/sniper.png"},{"n":"剧毒恶臭","d":"移动时在身后留下臭气云。云会攻击其中的敌人并可能使其中毒；中毒可无限叠加。","u":"/zh-cn/wiki/weapons/#w-toxic_stench","c":"武器","i":"/assets/icons/weapons/toxic_stench.png"},{"n":"英勇斩","d":"朝最近的敌人弧形斩击。每第 3 次挥砍旋转 360°，暴击率 +100%。","u":"/zh-cn/wiki/weapons/#w-valiant_slash","c":"武器","i":"/assets/icons/weapons/valiant_slash.png"},{"n":"狂野疾风","d":"吹出追踪敌人的阵风。在空中发出的阵风造成双倍伤害。","u":"/zh-cn/wiki/weapons/#w-wind","c":"武器","i":"/assets/icons/weapons/wind.png"},{"n":"石肤","d":"你的皮肤坚硬如岩：获得护甲，减少受到的伤害","u":"/zh-cn/wiki/instincts/#i-armor_passive","c":"本能","i":"/assets/icons/instincts/armor_passive.png"},{"n":"野性反射","d":"提高攻击速度","u":"/zh-cn/wiki/instincts/#i-attack_speed_passive","c":"本能","i":"/assets/icons/instincts/attack_speed_passive.png"},{"n":"均衡本能","d":"每级同时提升伤害、最大生命、移动速度和攻击速度","u":"/zh-cn/wiki/instincts/#i-balance_passive","c":"本能","i":"/assets/icons/instincts/balance_passive.png"},{"n":"混沌本能","d":"每级随机提升一项属性。稀有度越高越强：传说时是其专属本能的两倍","u":"/zh-cn/wiki/instincts/#i-chaos_passive","c":"本能","i":"/assets/icons/instincts/chaos_passive.png"},{"n":"锐利之眼","d":"提高造成暴击的几率","u":"/zh-cn/wiki/instincts/#i-crit_chance_passive","c":"本能","i":"/assets/icons/instincts/crit_chance_passive.png"},{"n":"凶猛撕咬","d":"提高暴击伤害","u":"/zh-cn/wiki/instincts/#i-crit_damage_passive","c":"本能","i":"/assets/icons/instincts/crit_damage_passive.png"},{"n":"锋利獠牙","d":"提高所有攻击的伤害","u":"/zh-cn/wiki/instincts/#i-damage_passive","c":"本能","i":"/assets/icons/instincts/damage_passive.png"},{"n":"黑暗印记","d":"敌人更多、生命更高、伤害略强，但掉落更多金币","u":"/zh-cn/wiki/instincts/#i-difficulty_passive","c":"本能","i":"/assets/icons/instincts/difficulty_passive.png"},{"n":"滑溜毛皮","d":"提高闪避敌人攻击的几率","u":"/zh-cn/wiki/instincts/#i-dodge_passive","c":"本能","i":"/assets/icons/instincts/dodge_passive.png"},{"n":"长引信","d":"延长你造成的效果的持续时间","u":"/zh-cn/wiki/instincts/#i-duration_passive","c":"本能","i":"/assets/icons/instincts/duration_passive.png"},{"n":"祖先本能","d":"每个敌人提供更多经验","u":"/zh-cn/wiki/instincts/#i-exp_passive","c":"本能","i":"/assets/icons/instincts/exp_passive.png"},{"n":"贪婪鼻子","d":"提高敌人掉落的金币","u":"/zh-cn/wiki/instincts/#i-gold_passive","c":"本能","i":"/assets/icons/instincts/gold_passive.png"},{"n":"青春热血","d":"你受到的所有治疗效果更好","u":"/zh-cn/wiki/instincts/#i-heal_passive","c":"本能","i":"/assets/icons/instincts/heal_passive.png"},{"n":"嗜血","d":"你从敌人身上偷取生命：每次直接命中都会治疗你。每100%生命偷取 = 每次命中回复1点生命。","u":"/zh-cn/wiki/instincts/#i-lifesteal_passive","c":"本能","i":"/assets/icons/instincts/lifesteal_passive.png"},{"n":"幸运胡须","d":"提高获得高稀有度奖励的几率","u":"/zh-cn/wiki/instincts/#i-lucky_passive","c":"本能","i":"/assets/icons/instincts/lucky_passive.png"},{"n":"灵敏嗅觉","d":"从更远处吸取经验球","u":"/zh-cn/wiki/instincts/#i-magnet_passive","c":"本能","i":"/assets/icons/instincts/magnet_passive.png"},{"n":"厚实皮毛","d":"提高最大生命值","u":"/zh-cn/wiki/instincts/#i-max_health_passive","c":"本能","i":"/assets/icons/instincts/max_health_passive.png"},{"n":"迅捷爪足","d":"提高移动速度","u":"/zh-cn/wiki/instincts/#i-movement_speed_passive","c":"本能","i":"/assets/icons/instincts/movement_speed_passive.png"},{"n":"狂野冲劲","d":"你的弹道飞得更快、更远","u":"/zh-cn/wiki/instincts/#i-projectile_speed_passive","c":"本能","i":"/assets/icons/instincts/projectile_speed_passive.png"},{"n":"额外弹道","d":"你的武器发射更多弹道。对利刃毛皮、火焰喷射器和剧毒恶臭无效。","u":"/zh-cn/wiki/instincts/#i-quantity_passive","c":"本能","i":"/assets/icons/instincts/quantity_passive.png"},{"n":"稳健心跳","d":"每秒恢复一定比例的最大生命","u":"/zh-cn/wiki/instincts/#i-regen_passive","c":"本能","i":"/assets/icons/instincts/regen_passive.png"},{"n":"硬壳","d":"获得一面吸收伤害的蓝色护盾，未受攻击时会自动再生","u":"/zh-cn/wiki/instincts/#i-shield_passive","c":"本能","i":"/assets/icons/instincts/shield_passive.png"},{"n":"淬毒之爪","d":"提高施加状态效果的几率；超过 100% 时会额外叠加层数","u":"/zh-cn/wiki/instincts/#i-status_chance_passive","c":"本能","i":"/assets/icons/instincts/status_chance_passive.png"},{"n":"食腐本能","d":"提高对处于状态效果下的敌人造成的伤害","u":"/zh-cn/wiki/instincts/#i-status_damage_passive","c":"本能","i":"/assets/icons/instincts/status_damage_passive.png"},{"n":"尖刺毛皮","d":"你的毛皮竖起尖刺：触碰你的敌人会损失部分最大生命。首领皮糙肉厚，只损失十分之一。","u":"/zh-cn/wiki/instincts/#i-thorns_passive","c":"本能","i":"/assets/icons/instincts/thorns_passive.png"},{"n":"疯长","d":"使你的武器和投射物变得更大","u":"/zh-cn/wiki/instincts/#i-weapon_size_passive","c":"本能","i":"/assets/icons/instincts/weapon_size_passive.png"},{"n":"泻湖蛞蝓","d":"10 秒内未受到伤害时，每秒恢复 1% 最大生命值。每层叠加额外 +1%。","u":"/zh-cn/wiki/items/#it-babosa_laguna","c":"道具","i":"/assets/icons/items/babosa_laguna.png"},{"n":"水豚点心","d":"击杀时每层叠加有 1% 几率掉落食物，回复你最大生命值的 5%。","u":"/zh-cn/wiki/items/#it-bocado_capibar","c":"道具","i":"/assets/icons/items/bocado_capibar.png"},{"n":"疾风围巾","d":"处于空中时伤害提高 15%。每层叠加均可累积。","u":"/zh-cn/wiki/items/#it-bufanda_viento","c":"道具","i":"/assets/icons/items/bufanda_viento.png"},{"n":"皮革斗篷","d":"每层叠加使闪避几率 +5%，最高 95%。","u":"/zh-cn/wiki/items/#it-capa_cuero","c":"道具","i":"/assets/icons/items/capa_cuero.png"},{"n":"冠军腰带","d":"生命值全满时造成的伤害提高 20%。每层叠加再提高 20%。","u":"/zh-cn/wiki/items/#it-cinturon_campeon","c":"道具","i":"/assets/icons/items/cinturon_campeon.png"},{"n":"锻造獠牙","d":"每层叠加使你对精英敌人和首领造成的伤害提高 25%。","u":"/zh-cn/wiki/items/#it-colmillos_forjados","c":"道具","i":"/assets/icons/items/colmillos_forjados.png"},{"n":"望远瞄准镜","d":"暴击率 +10%（x2 伤害）。每次拾取均可叠加。","u":"/zh-cn/wiki/items/#it-critical_chance","c":"道具","i":"/assets/icons/items/critical_chance.png"},{"n":"水晶护盾","d":"3 秒内未受到伤害时生成一面护盾，完全吸收下一次攻击。","u":"/zh-cn/wiki/items/#it-escudo_cristal","c":"道具","i":"/assets/icons/items/escudo_cristal.png"},{"n":"布袋莲刺","d":"命中时有 4% 几率施加流血：每层叠加在 2 秒内造成该次命中 100% 的伤害。流血叠至 5 层时爆发，一次性造成剩余伤害。","u":"/zh-cn/wiki/items/#it-espina_aguape","c":"道具","i":"/assets/icons/items/espina_aguape.png"},{"n":"便携蹦床","d":"额外获得 +1 次跳跃。每次拾取均可叠加。","u":"/zh-cn/wiki/items/#it-extra_jump","c":"道具","i":"/assets/icons/items/extra_jump.png"},{"n":"伏击之爪","d":"对生命值高于 90% 的敌人伤害 +20%。每次拾取均可叠加。","u":"/zh-cn/wiki/items/#it-high_hp_damage","c":"道具","i":"/assets/icons/items/high_hp_damage.png"},{"n":"幸运袋","d":"金币获取 +25%。每次拾取均可叠加。","u":"/zh-cn/wiki/items/#it-lucky_bag","c":"道具","i":"/assets/icons/items/lucky_bag.png"},{"n":"发酵芒果","d":"命中时有 3% 几率引发爆炸，对敌人周围区域造成你 80% 的伤害。","u":"/zh-cn/wiki/items/#it-mango_fermentado","c":"道具","i":"/assets/icons/items/mango_fermentado.png"},{"n":"木锤","d":"命中时有 5% 几率击退敌人。对首领无效。","u":"/zh-cn/wiki/items/#it-martillo_madera","c":"道具","i":"/assets/icons/items/martillo_madera.png"},{"n":"爆裂马黛茶","d":"每层叠加使冲刺冷却时间减少 15%。","u":"/zh-cn/wiki/items/#it-mate_explosivo","c":"道具","i":"/assets/icons/items/mate_explosivo.png"},{"n":"假币","d":"+10% 几率免费开启宝箱（收益递减）。免费开启的宝箱不会提高下一个宝箱的价格。","u":"/zh-cn/wiki/items/#it-moneda_falsa","c":"道具","i":"/assets/icons/items/moneda_falsa.png"},{"n":"蓝色耳环","d":"每层叠加使你的攻击速度提高 10%。","u":"/zh-cn/wiki/items/#it-pendientes_azules","c":"道具","i":"/assets/icons/items/pendientes_azules.png"},{"n":"水豚蹄子","d":"每层叠加使你的移动速度提高 15%。","u":"/zh-cn/wiki/items/#it-pezunas_capibara","c":"道具","i":"/assets/icons/items/pezunas_capibara.png"},{"n":"苦草","d":"击杀敌人时永久获得 5 点最大生命值。每层叠加使上限提高 100 点额外生命值。","u":"/zh-cn/wiki/items/#it-yerba_mala","c":"道具","i":"/assets/icons/items/yerba_mala.png"},{"n":"会说话的头","d":"每秒持续损失 1% 最大生命值，但你的总伤害翻倍。","u":"/zh-cn/wiki/items/#it-cabeza_parlante","c":"道具","i":"/assets/icons/items/cabeza_parlante.png"},{"n":"水豚尾巴","d":"你的攻击有 10% 几率眩晕被击中的敌人。对首领无效。","u":"/zh-cn/wiki/items/#it-cola_capibara","c":"道具","i":"/assets/icons/items/cola_capibara.png"},{"n":"冰冻手指","d":"连续击杀 20 个敌人且未受到伤害时，在你所在位置召唤一场冰暴，对敌人造成伤害，持续 5 秒。其范围随武器尺寸增大，收益递减。受到伤害会重置计数。","u":"/zh-cn/wiki/items/#it-dedo_congelado","c":"道具","i":"/assets/icons/items/dedo_congelado.png"},{"n":"致幻蘑菇","d":"击杀精英敌人时进入狂乱状态 4 秒：+50% 攻击速度，+100% 移动速度。","u":"/zh-cn/wiki/items/#it-hongo_alucinogeno","c":"道具","i":"/assets/icons/items/hongo_alucinogeno.png"},{"n":"玩家护目镜","d":"每损失 1% 生命值，伤害提高 1%。每层叠加再提高 1%。","u":"/zh-cn/wiki/items/#it-lentes_gamer","c":"道具","i":"/assets/icons/items/lentes_gamer.png"},{"n":"树叶眼镜","d":"受到任意状态效果影响的敌人，每层叠加额外承受 60% 伤害。","u":"/zh-cn/wiki/items/#it-lentes_hojas","c":"道具","i":"/assets/icons/items/lentes_hojas.png"},{"n":"魔法飞弹","d":"击杀敌人时发射 2 枚追踪敌人的魔法飞弹，命中或持续时间结束时爆炸。","u":"/zh-cn/wiki/items/#it-misil_magico","c":"道具","i":"/assets/icons/items/misil_magico.png"},{"n":"属性吸收枪","d":"击杀精英敌人时，你的总伤害翻倍，持续 4 秒。","u":"/zh-cn/wiki/items/#it-pistola_absorbe_stats","c":"道具","i":"/assets/icons/items/pistola_absorbe_stats.png"},{"n":"碎裂棱镜","d":"你的武器获得 +1 数量。每次拾取均可叠加。","u":"/zh-cn/wiki/items/#it-prisma_trizado","c":"道具","i":"/assets/icons/items/prisma_trizado.png"},{"n":"贪吃吸尘器","d":"每 20 秒将地图上所有经验球吸向你。每层叠加缩短 3 秒（最少 8 秒）。","u":"/zh-cn/wiki/items/#it-aspiradora_glotona","c":"道具","i":"/assets/icons/items/aspiradora_glotona.png"},{"n":"音乐 CD","d":"5 秒内击杀 20 个敌人即可开启迪斯科模式：每次击杀都会从你的位置向随机敌人发射一张 CD。","u":"/zh-cn/wiki/items/#it-cd_musica","c":"道具","i":"/assets/icons/items/cd_musica.png"},{"n":"灵魂水晶","d":"每击杀 100 名敌人为水晶充能。充满后，生命值低于 50% 时水晶碎裂，恢复 30% 最大生命值（最多每 20 秒一次）。叠加越多，充能越快。","u":"/zh-cn/wiki/items/#it-cristal_alma","c":"道具","i":"/assets/icons/items/cristal_alma.png"},{"n":"奇怪药水","d":"你的所有治疗效果翻倍。每层叠加使效果再次翻倍。","u":"/zh-cn/wiki/items/#it-extrana_pocima","c":"道具","i":"/assets/icons/items/extrana_pocima.png"},{"n":"黑猫","d":"每局一次，生命值降至 0 时以 15% 最大生命值复活，并获得 5 秒无敌。","u":"/zh-cn/wiki/items/#it-gato_negro","c":"道具","i":"/assets/icons/items/gato_negro.png"},{"n":"附魔神灯","d":"你的道具的命中几率效果额外判定 1 次。每层叠加再多判定 1 次，最多 3 次。","u":"/zh-cn/wiki/items/#it-lampara_encantada","c":"道具","i":"/assets/icons/items/lampara_encantada.png"},{"n":"萨满面具","d":"每次受到治疗时，自动发射一枚魔法骷髅，造成治疗量 250% 的伤害。","u":"/zh-cn/wiki/items/#it-mascara_chaman","c":"道具","i":"/assets/icons/items/mascara_chaman.png"},{"n":"沙袋","d":"连续攻击同一敌人时，每层每次命中额外增加 +0.1% 伤害。上限 +200%，每多一层上限再增加 +200%。攻击其他敌人会重置计数。","u":"/zh-cn/wiki/items/#it-saco_boxeo","c":"道具","i":"/assets/icons/items/saco_boxeo.png"},{"n":"食人花种子","d":"击杀敌人时有 7% 几率召唤一株友方食人花，攻击附近敌人，持续 30 秒。","u":"/zh-cn/wiki/items/#it-semillas_carnivoras","c":"道具","i":"/assets/icons/items/semillas_carnivoras.png"},{"n":"木戒指","d":"暴击使你的攻击速度提高 10%，持续 2 秒，最多提高 30%。","u":"/zh-cn/wiki/items/#it-anillo_madera","c":"道具","i":"/assets/icons/items/anillo_madera.png"},{"n":"黏稠黏液","d":"命中时有 20% 几率使敌人减速 40%，持续 1 秒。对首领无效。","u":"/zh-cn/wiki/items/#it-baba_viscosa","c":"道具","i":"/assets/icons/items/baba_viscosa.png"},{"n":"稻草斗篷","d":"处于空中时，每层叠加使受到的伤害降低 20%，最多降低 80%。","u":"/zh-cn/wiki/items/#it-capa_paja","c":"道具","i":"/assets/icons/items/capa_paja.png"},{"n":"冲刺弹匣","d":"冲刺次数 +1。每层叠加均可累积，最多 4 次。","u":"/zh-cn/wiki/items/#it-cargador_dash","c":"道具","i":"/assets/icons/items/cargador_dash.png"},{"n":"电线","d":"命中时有 5% 几率在附近敌人之间释放连锁闪电。","u":"/zh-cn/wiki/items/#it-cordel_electrico","c":"道具","i":"/assets/icons/items/cordel_electrico.png"},{"n":"河狸鼠之牙","d":"每层叠加提供 +10% 生命偷取。","u":"/zh-cn/wiki/items/#it-dientes_coipu","c":"道具","i":"/assets/icons/items/dientes_coipu.png"},{"n":"电击插头","d":"受到伤害时释放电击，对附近敌人造成你最大生命值 10% 的伤害。每层叠加 +5% 并扩大范围。冷却 1 秒。","u":"/zh-cn/wiki/items/#it-enchufe_electrico","c":"道具","i":"/assets/icons/items/enchufe_electrico.png"},{"n":"鬼火","d":"击杀敌人时有 5% 几率召唤鬼火，每秒造成 40 点伤害，持续 5 秒。","u":"/zh-cn/wiki/items/#it-fuego_fatuo","c":"道具","i":"/assets/icons/items/fuego_fatuo.png"},{"n":"爆头","d":"生命值不高于 5% 的敌人（包括精英）受到任何攻击都会被立即击杀。对首领无效。","u":"/zh-cn/wiki/items/#it-headshot","c":"道具","i":"/assets/icons/items/headshot.png"},{"n":"橡胶球","d":"命中时有 10% 几率发射一颗自动追踪敌人的橡胶球。","u":"/zh-cn/wiki/items/#it-pelota_goma","c":"道具","i":"/assets/icons/items/pelota_goma.png"},{"n":"践踏","d":"从高处落地时重击地面，伤害附近的敌人。落差越高伤害越高（最多 x4）。每层叠加 +100% 伤害并扩大范围。","u":"/zh-cn/wiki/items/#it-pisoton","c":"道具","i":"/assets/icons/items/pisoton.png"},{"n":"武器栏位","d":"解锁一个额外栏位，可多携带一把武器（最多 2 个）。","u":"/zh-cn/wiki/progression/#a-weapon_slots","c":"成长与解锁","i":""},{"n":"本能栏位","d":"解锁一个额外栏位，可多携带一个动物本能（最多 2 个）。","u":"/zh-cn/wiki/progression/#a-instinct_slots","c":"成长与解锁","i":""},{"n":"额外数量","d":"每级使所有武器 +1 数量。","u":"/zh-cn/wiki/progression/#a-num_projectiles","c":"成长与解锁","i":""},{"n":"钱币","d":"每级 +10% 金币获取。","u":"/zh-cn/wiki/progression/#a-coins","c":"成长与解锁","i":""},{"n":"初始生命","d":"每级 +10% 最大生命值。","u":"/zh-cn/wiki/progression/#a-max_health","c":"成长与解锁","i":""},{"n":"伤害","d":"每级 +10% 伤害。","u":"/zh-cn/wiki/progression/#a-damage","c":"成长与解锁","i":""},{"n":"护甲","d":"每级 +10 护甲。","u":"/zh-cn/wiki/progression/#a-armor","c":"成长与解锁","i":""},{"n":"攻击速度","d":"每级 +5% 攻击速度。","u":"/zh-cn/wiki/progression/#a-attack_speed","c":"成长与解锁","i":""},{"n":"效果持续时间","d":"每级 +10% 效果持续时间（火焰、灼烧）。","u":"/zh-cn/wiki/progression/#a-effect_duration","c":"成长与解锁","i":""},{"n":"西瓜磁铁","d":"每级 +25% 经验球拾取范围。","u":"/zh-cn/wiki/progression/#a-xp_magnet","c":"成长与解锁","i":""},{"n":"武器尺寸","d":"每级 +6% 武器尺寸。","u":"/zh-cn/wiki/progression/#a-weapon_size","c":"成长与解锁","i":""},{"n":"弹道速度","d":"每级 +10% 弹道速度。","u":"/zh-cn/wiki/progression/#a-projectile_speed","c":"成长与解锁","i":""},{"n":"移动速度","d":"每级 +8% 移动速度。","u":"/zh-cn/wiki/progression/#a-movement_speed","c":"成长与解锁","i":""},{"n":"幸运","d":"每级 +0.25 初始幸运。","u":"/zh-cn/wiki/progression/#a-luck","c":"成长与解锁","i":""},{"n":"经验","d":"每级 +8% 经验获取。","u":"/zh-cn/wiki/progression/#a-exp","c":"成长与解锁","i":""},{"n":"红宝石掉落","d":"提高普通敌人掉落红宝石的几率，以及精英敌人和首领掉落红宝石的数量。","u":"/zh-cn/wiki/progression/#a-rubies","c":"成长与解锁","i":""},{"n":"复活","d":"死亡时复活一次（最多 2 次）。","u":"/zh-cn/wiki/progression/#a-revive","c":"成长与解锁","i":""},{"n":"重掷","d":"重掷升级时的选项（每级 1 次）。","u":"/zh-cn/wiki/progression/#a-reroll","c":"成长与解锁","i":""},{"n":"剔除武器","d":"在本局中从候选池剔除一把武器或一个本能（每级 1 次）。","u":"/zh-cn/wiki/progression/#a-ban_weapon","c":"成长与解锁","i":""},{"n":"剔除道具","d":"在本局中打开宝箱时剔除一个道具（每级 1 次）。","u":"/zh-cn/wiki/progression/#a-ban_item","c":"成长与解锁","i":""},{"n":"开关","d":"可以关闭已购买的武器、本能和道具,让它们不会出现在你的对局中。初始内容无法关闭。","u":"/zh-cn/wiki/progression/#a-toggler","c":"成长与解锁","i":""},{"n":"修格斯","d":"无形之恐 会在你身边传送、直线冲撞穿过你的飞行怪物。冲刺前先看清它的前摇。","u":"/zh-cn/wiki/bosses/#b-boss-shoggoth","c":"首领","i":"/assets/sprites/boss_shoggoth.png"},{"n":"虚空女神","d":"虚空之女 能预判你闪避的方向，并把手掌法术直接砸在那里，随后放出四发散射弹。","u":"/zh-cn/wiki/bosses/#b-boss-voidborn-goddes","c":"首领","i":"/assets/sprites/boss_voidborn_goddes.png"},{"n":"虚空召唤者","d":"深渊先驱 在竞技场中四处传送，轮流施放黑暗火焰、激光和从地面升起的触手。","u":"/zh-cn/wiki/bosses/#b-boss-voidcaller","c":"首领","i":"/assets/sprites/boss_voidcaller.png"},{"n":"C-Rex","d":" 接受幽灵水豚的请求并摧毁方尖碑后出现。击败它即可开启 C-Rex 的解锁链。","u":"/zh-cn/wiki/bosses/#b-boss-c-rex","c":"首领","i":"/assets/sprites/boss_c_rex.png"},{"n":"森林巨鲸","d":"深林歌者 一头飞行的鲸鱼，会留下强化附近敌人的尘雾，发射有预警的飞镖，并蓄力射出一颗缓慢的能量球。","u":"/zh-cn/wiki/bosses/#b-boss-hada","c":"首领","i":"/assets/sprites/boss_hada.png"},{"n":"螳螂","d":"苔藓收割者 一只巨型螳螂，轮流使用三种攻击：近身突刺、在地面标记位置的跳跃重击，以及三把刀刃的锥形斩击。","u":"/zh-cn/wiki/bosses/#b-boss-mantis","c":"首领","i":"/assets/sprites/boss_mantis.png"},{"n":"肥胖植物","d":"沼泽饕餮 一株巨大的食人植物，会在你附近扎根。施放带毒的孢子环、酸雨和一颗缓慢追踪的酸液球。","u":"/zh-cn/wiki/bosses/#b-boss-planta-gorda","c":"首领","i":"/assets/sprites/boss_planta_gorda.png"},{"n":"死亡使者","d":"末息信使 每隔几秒就传送到视野内的一处平台，挥砍、放出黑暗波，并在你脚下召出传送门之手。","u":"/zh-cn/wiki/bosses/#b-boss-bringer-of-death","c":"首领","i":"/assets/sprites/boss_bringer_of_death.png"},{"n":"白骨之轮","d":"碎骨磨坊 一个滚动的骨头轮。连续五次幽灵冲刺，还有一记从天而降、砸向你脚下标记的腹部重压。","u":"/zh-cn/wiki/bosses/#b-boss-bone-wheel","c":"首领","i":"/assets/sprites/boss_bone_wheel.png"},{"n":"死神","d":"无人能逃者 从上方和下方把镰刀像回旋镖一样甩出，向你俯冲，并召唤骷髅弓箭手。","u":"/zh-cn/wiki/bosses/#b-boss-death","c":"首领","i":"/assets/sprites/boss_death.png"},{"n":"Skelly-san","d":" 归还被撕破的旗帜后，它会从粉色之门中现身。击败它即可开启 Skelly-san 的解锁链。","u":"/zh-cn/wiki/bosses/#b-boss-skelly-san","c":"首领","i":"/assets/sprites/boss_skelly_san.png"},{"n":"暴龙王","d":"冰河时代之王 一头巨型恐龙，会在半空中定格再腹部猛砸，以幽灵冲刺横穿房间，并召唤让天空落下球体的旗帜。","u":"/zh-cn/wiki/bosses/#b-boss-dino-rex","c":"首领","i":"/assets/sprites/boss_dino_rex.png"},{"n":"企鹅王","d":"冰川帝王 一只戴墨镜的企鹅：跳跃啄击、依次落下的冰块，以及横扫的光束。","u":"/zh-cn/wiki/bosses/#b-boss-pengu","c":"首领","i":"/assets/sprites/boss_pengu.png"},{"n":"Lisa","d":"冰潮女巫 一位会飞的女术士，拥有五种法术：上升的气泡、水之爆炸、从地面冒出的头颅、不断合拢的冰墙和坠落的冰刺。","u":"/zh-cn/wiki/bosses/#b-boss-lisa","c":"首领","i":"/assets/sprites/boss_lisa.png"},{"n":"雪怪","d":"群峰之惧 当你试图救出困在雪中的攀登者时到来。抛出弧线雪球，跳跃落地时掀起一道冰浪。","u":"/zh-cn/wiki/bosses/#b-boss-yeti","c":"首领","i":"/assets/sprites/boss_yeti.png"},{"n":"恶魔武士","d":"无主之刃 三连斩组合技，每一刀都伴随冲刺，外加跳跃斩击。生命值降到一半时会发出怒吼，点燃刀刃，变得更快更硬。","u":"/zh-cn/wiki/bosses/#b-boss-demon-samurai","c":"首领","i":"/assets/sprites/boss_demon_samurai.png"},{"n":"傀儡 H","d":"石之傀儡 一具漂浮的石之傀儡，闭上的眼睛会揭示下一个法术：合拢的岩墙、在你脚下升起的石柱，或从天而降的水晶拳头。","u":"/zh-cn/wiki/bosses/#b-boss-puppet-h","c":"首领","i":"/assets/sprites/boss_puppet_h.png"},{"n":"Bertha","d":"沙漠之斧 一个持斧的巨型哥布林：沉重的连击、向前掀起大地喷发的践踏、跳跃猛砸，以及持续五秒的龙卷风。","u":"/zh-cn/wiki/bosses/#b-boss-bertha","c":"首领","i":"/assets/sprites/boss_bertha.png"},{"n":"莫萨格","d":"灰烬领主 原地扎根，向前喷出巨大的火焰，在你周围掀起火焰龙卷风，并在头顶蓄力引爆。","u":"/zh-cn/wiki/bosses/#b-boss-morthag","c":"首领","i":"/assets/sprites/boss_morthag.png"},{"n":"恶魔史莱姆","d":"活体黑焰 起初是一只拥有独立生命条、蹦来蹦去的史莱姆。随后化身为手持砍刀的恶魔，使出三连跳和黑色火焰。","u":"/zh-cn/wiki/bosses/#b-boss-demon-slime","c":"首领","i":"/assets/sprites/boss_demon_slime.png"},{"n":"Megumi","d":"蝾螈女巫 一位火蜥蜴女巫，在房间中疾奔，施放黑洞、火焰龙卷风和火球。每施放几个法术，她的火蜥蜴就会化为巨龙，射出贯穿整个关卡的光束。","u":"/zh-cn/wiki/bosses/#b-boss-megumi","c":"首领","i":"/assets/sprites/boss_megumi.png"},{"n":"吞噬者","d":" 在第 3 层之后的封印房间中等待，由你必须站上去的鲜血之心守护。它会偷走你的道具，并在你伤到它时归还。冲撞、口中激光和之字形猛扑。","u":"/zh-cn/wiki/bosses/#b-boss-devorador","c":"首领","i":"/assets/sprites/boss_devorador.png"},{"n":"吞噬者之母","d":" 在吞噬者倒下时到来。更多的心脏、双重激光，还能生出更小的吞噬者。击败她即可完成前 300 层。","u":"/zh-cn/wiki/bosses/#b-boss-devorador-madre","c":"首领","i":"/assets/sprites/boss_devorador_madre.png"},{"n":"Morrigal，最后的守夜人","d":" 一名拥有两条生命条的黑暗骑士，会偷走你的武器，并在战斗中逐一归还。每种攻击都有物理版本，变身后还有爆炸版本。守夜之焰让它始终处于护盾保护之下。","u":"/zh-cn/wiki/bosses/#b-boss-morrigal","c":"首领","i":"/assets/sprites/boss_morrigal.png"},{"n":"卡皮魔王","d":" 召唤塔顶所有首领的那位，每两分钟召唤一名。在每个关卡尽头的管风琴前，以光之牢笼、脉冲和激光应战，然后经由传送门撤退。它在最高处的王座上等待。","u":"/zh-cn/wiki/bosses/#b-boss-capy-demon-king","c":"首领","i":"/assets/sprites/boss_capy_demon_king.png"},{"n":"眼球","d":"飞行追击者。能穿墙，接触造成伤害。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_eyeball.png"},{"n":"蚊子","d":"飞行冲刺者。先悬停，再从你身边猛扑而过。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_mosquito.png"},{"n":"定时炸弹","d":"飞行自爆者。倒数 3、2、1 后在范围内爆炸。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_time_bomb.png"},{"n":"法师邪教徒","d":"在平台间行走，每隔几秒施放一发弹体。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_mage_cultist.png"},{"n":"刺客邪教徒","d":"快速的近战邪教徒。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_assassin_cultist.png"},{"n":"巨型邪教徒","d":"缓慢而沉重的近战邪教徒。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_big_cultist.png"},{"n":"蘑菇","d":"近战追击者，会像弹体一样朝你扑来。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_mushroom.png"},{"n":"跳跳蛙","d":"四处蹦跳，从远处用舌头攻击你。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_frogger.png"},{"n":"甲虫","d":"飞行追击者。接触造成伤害。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_bug.png"},{"n":"巨型苍蝇","d":"飞行冲刺者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_giant_fly.png"},{"n":"蜜蜂","d":"飞近之后，化作一支笔直加速的飞镖射向你。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_bee.png"},{"n":"水母菇","d":"毒性自爆者。不断膨胀、变绿，然后炸出毒雾。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_jelly_mushroom.png"},{"n":"火焰辣椒","d":"有四种颜色的远程施法者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_fire_pepper.png"},{"n":"邪恶藤蔓","d":"第 5 分钟的事件：食人藤蔓在整座塔中升起。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_evil_vine.png"},{"n":"白骨角斗士","d":"近战，带突刺和短距离冲刺。攻击距离比看上去更远。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_bones_gladiator.png"},{"n":"黑暗骑士","d":"重型近战：两次挥砍，每次都伴随长距离冲刺。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_dark_knight.png"},{"n":"感染爆破者","d":"坦克型自爆者，冲到你面前炸开，即使你先杀死它也会爆炸。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_infected_exploder.png"},{"n":"Beholder","d":"飞行追击者，会短距离前扑咬人。","u":"/zh-cn/wiki/enemies/#e-beholder","c":"敌人","i":"/assets/sprites/enemy_beholder.png"},{"n":"鲜血之龙","d":"冲向它起冲那一刻你所在的位置，靠近时会用爪子撕抓。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_blood_dragon.png"},{"n":"BatZ","d":"从不追击的远程飞行者。以五只为一队出现。","u":"/zh-cn/wiki/enemies/#e-batz","c":"敌人","i":"/assets/sprites/enemy_batz.png"},{"n":"哨兵之眼","d":"在固定高度巡逻。如果它看到你并存活五秒，就会触发眼群：满是眼睛的红色通道横穿整座塔。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_sentinel_eye.png"},{"n":"冰霜魔像","d":"拥有两种不同攻击的重型近战。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_ice_golem.png"},{"n":"幻影骑士","d":"使用新月斩的敏捷近战。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_phantom_knight.png"},{"n":"水之精魂","d":"飞行追击者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_water_wisp.png"},{"n":"收割者","d":"快速的飞行追击者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_reaper.png"},{"n":"Imp","d":"保持距离并发射弩箭的远程飞行者。","u":"/zh-cn/wiki/enemies/#e-imp","c":"敌人","i":"/assets/sprites/enemy_imp.png"},{"n":"冬狼","d":"在咒语下沉睡，直到你靠近。只在一个支线任务中出现。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_winter_wolf.png"},{"n":"灯神强盗","d":"使用镰刀斩击的快速近战。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_djinn_bandit.png"},{"n":"赤红食人魔","d":"沉重的武士刀斩击。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_red_ogre.png"},{"n":"黄蜂","d":"飞行追击者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_wasp.png"},{"n":"Oculothorax","d":"咬一口就逃，再咬一口再逃。","u":"/zh-cn/wiki/enemies/#e-oculothorax","c":"敌人","i":"/assets/sprites/enemy_oculothorax.png"},{"n":"大地精魂","d":"发射石弹的远程飞行者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_earth_wisp.png"},{"n":"风之精魂","d":"发出红光并释放冲击波。这样做并不会让它死去。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_wind_wisp.png"},{"n":"处刑恶魔","d":"将巨剑向下猛插，接着是一记长距离突刺。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_executioner_demon.png"},{"n":"诅咒恶魔","d":"原地站定，向前方射出诅咒光束。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_curse_demon.png"},{"n":"Tharnok 恶魔","d":"跳到你刚才站的位置，溅出火焰。","u":"/zh-cn/wiki/enemies/#e-tharnok","c":"敌人","i":"/assets/sprites/enemy_tharnok_demon.png"},{"n":"燃烧骷髅","d":"飞行追击者。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_burning_skull.png"},{"n":"Alkara 恶魔","d":"飞行施法者，交替发射火球与俯冲。","u":"/zh-cn/wiki/enemies/#e-alkara","c":"敌人","i":"/assets/sprites/enemy_alkara_demon.png"},{"n":"恶魔地雷","d":"漂浮的地雷，会越来越红，直到爆炸。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_demon_mine.png"},{"n":"巨型骷髅","d":"每分钟一只。悬停在你上方向下喷火。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_large_skull.png"},{"n":"游魂","d":"游魂大军（第 10 分钟之后）中唯一的敌人，被染成当前等级的颜色。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_lost_soul.png"},{"n":"盗贼哥布林","d":"每隔几分钟从地下冒出来逃跑。每次击中都会掉落金币或红宝石；杀死它会让剩下的财宝一并爆出。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_goblin_thief.png"},{"n":"Wendigo","d":"岩石与冰雪中挑战雕像的挑战敌人。从一道光柱中降下。","u":"/zh-cn/wiki/enemies/#e-wendigo","c":"敌人","i":"/assets/sprites/enemy_wendigo.png"},{"n":"鱼人","d":"苔藓与沙漠中的挑战敌人。用爪子攻击，并以弧线抛出水球。","u":"/zh-cn/wiki/enemies/#e-x","c":"敌人","i":"/assets/sprites/enemy_fishman.png"},{"n":"ExperimentZ","d":"鲜血与火山中的挑战敌人。从很远的地方向你扑撞。","u":"/zh-cn/wiki/enemies/#e-experimentz","c":"敌人","i":"/assets/sprites/enemy_experimentz.png"}]