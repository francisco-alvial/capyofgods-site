[{"n":"플레이 방법","d":"조작, 경험치, 레벨 업, 상자, 구조물, 보스 소환, 그리고 무리.","u":"/ko/wiki/how-to-play/","c":"Wiki","i":"/assets/icons/characters/bob.png"},{"n":"캐릭터","d":"플레이 가능한 카피바라 12마리: 능력치, 시작 무기, 패시브, 잠금 해제 방법.","u":"/ko/wiki/characters/","c":"Wiki","i":"/assets/icons/characters/caparzo.png"},{"n":"무기","d":"모든 자동 무기의 효과와 잠금 해제 방법.","u":"/ko/wiki/weapons/","c":"Wiki","i":"/assets/icons/weapons/fireball.png"},{"n":"본능","d":"레벨 업 때 고르는 동물 본능(패시브) 26종.","u":"/ko/wiki/instincts/","c":"Wiki","i":"/assets/icons/instincts/armor_passive.png"},{"n":"아이템","d":"상자와 상점에서 얻는 아이템을 등급별로, 효과와 함께.","u":"/ko/wiki/items/","c":"Wiki","i":"/assets/icons/items/lampara_encantada.png"},{"n":"보스","d":"중간 보스, 층 보스, 미션 보스, 그리고 각 등반의 최종 전투.","u":"/ko/wiki/bosses/","c":"Wiki","i":"/assets/sprites/boss_devorador.png"},{"n":"적","d":"생태계별 일반 적과 그 행동.","u":"/ko/wiki/enemies/","c":"Wiki","i":"/assets/sprites/enemy_eyeball.png"},{"n":"등반","d":"세 번의 등반, 생태계, 시간대별 이벤트, 난이도, 순위표.","u":"/ko/wiki/tower/","c":"Wiki","i":"/assets/sprites/enemy_sentinel_eye.png"},{"n":"성장과 잠금 해제","d":"루비, 영구 속성, 잠금 해제 연계, 그리고 전체 미션 목록.","u":"/ko/wiki/progression/","c":"Wiki","i":"/assets/icons/items/lucky_bag.png"},{"n":"세계관","d":"Sir Capy Drake의 전설, 진홍 봉우리, 그리고 Capy of Gods라 불리는 경쟁.","u":"/ko/wiki/lore/","c":"Wiki","i":"/assets/sprites/boss_capy_demon_king.png"},{"n":"자주 묻는 질문","d":"앞서 해보기, 가격, 플랫폼, 언어, 방송 등.","u":"/ko/wiki/faq/","c":"Wiki","i":"/assets/brand/favicon.png"},{"n":"Bob","d":"탐정의 코","u":"/ko/wiki/characters/#c-bob","c":"캐릭터","i":"/assets/icons/characters/bob.png"},{"n":"C-Rex","d":"원시의 분노","u":"/ko/wiki/characters/#c-c_rex","c":"캐릭터","i":"/assets/icons/characters/c_rex.png"},{"n":"조니","d":"단단한 등껍질","u":"/ko/wiki/characters/#c-caparzo","c":"캐릭터","i":"/assets/icons/characters/caparzo.png"},{"n":"카피틴 게일","d":"순풍","u":"/ko/wiki/characters/#c-capytain_gale","c":"캐릭터","i":"/assets/icons/characters/capytain_gale.png"},{"n":"Deadeye","d":"치명적인 조준","u":"/ko/wiki/characters/#c-deadeye","c":"캐릭터","i":"/assets/icons/characters/deadeye.png"},{"n":"Dr. Plague","d":"타오르는 열병","u":"/ko/wiki/characters/#c-dr_peste","c":"캐릭터","i":"/assets/icons/characters/dr_peste.png"},{"n":"Gary","d":"조립 라인","u":"/ko/wiki/characters/#c-gary","c":"캐릭터","i":"/assets/icons/characters/gary.png"},{"n":"Lycap","d":"피의 갈망","u":"/ko/wiki/characters/#c-lycap","c":"캐릭터","i":"/assets/icons/characters/lycap.png"},{"n":"Sir Drake Jr.","d":"기사의 자존심","u":"/ko/wiki/characters/#c-sir_drake_jr","c":"캐릭터","i":"/assets/icons/characters/sir_drake_jr.png"},{"n":"Skelly-san","d":"아이돌 열풍","u":"/ko/wiki/characters/#c-skelly_san","c":"캐릭터","i":"/assets/icons/characters/skelly_san.png"},{"n":"스파키","d":"과충전","u":"/ko/wiki/characters/#c-sparky","c":"캐릭터","i":"/assets/icons/characters/sparky.png"},{"n":"Stinky","d":"가시지 않는 악취","u":"/ko/wiki/characters/#c-stinky","c":"캐릭터","i":"/assets/icons/characters/stinky.png"},{"n":"칼날 털","d":"곤두선 털의 오라가 근처의 모든 것에 피해를 줍니다","u":"/ko/wiki/weapons/#w-aura","c":"무기","i":"/assets/icons/weapons/aura.png"},{"n":"발톱 휘두르기","d":"가장 가까운 적 방향의 원뿔 범위를 할큅니다. 처치 시 5% 확률로 체력 1 회복.","u":"/ko/wiki/weapons/#w-claw_sweep","c":"무기","i":"/assets/icons/weapons/claw_sweep.png"},{"n":"독성 침","d":"적 사이를 튕겨 다니는 독 투사체를 뱉습니다","u":"/ko/wiki/weapons/#w-escupo","c":"무기","i":"/assets/icons/weapons/escupo.png"},{"n":"불꽃 침","d":"괴물을 불태우는 화염구를 발사합니다","u":"/ko/wiki/weapons/#w-fireball","c":"무기","i":"/assets/icons/weapons/fireball.png"},{"n":"화염 방사기","d":"가장 가까운 적을 향해 회전하는 불길을 뿜어, 휩쓸고 지나간 모든 것을 불태울 수 있습니다","u":"/ko/wiki/weapons/#w-fireground","c":"무기","i":"/assets/icons/weapons/fireground.png"},{"n":"야광봉","d":"느려지다 방향을 틀어 되돌아오는 봉을 던집니다. 갈 때와 올 때 모두 적중합니다.","u":"/ko/wiki/weapons/#w-glow_stick","c":"무기","i":"/assets/icons/weapons/glow_stick.png"},{"n":"천둥 코일","d":"근처 적에게 전기 충격을 내리칩니다","u":"/ko/wiki/weapons/#w-lightning","c":"무기","i":"/assets/icons/weapons/lightning.png"},{"n":"문어 포탑","d":"3초마다 5초 동안 유지되는 문어 포탑을 설치해, 당신의 능력치로 근처 적을 사격합니다.","u":"/ko/wiki/weapons/#w-octo_sentry","c":"무기","i":"/assets/icons/weapons/octo_sentry.png"},{"n":"저격 소총","d":"일직선의 적을 관통하는 탄을 쏩니다. 마우스나 오른쪽 스틱으로 조준합니다","u":"/ko/wiki/weapons/#w-sniper","c":"무기","i":"/assets/icons/weapons/sniper.png"},{"n":"독성 악취","d":"이동하면 악취 구름이 남아 적을 공격하고 확률로 중독시킵니다. 독은 무한히 중첩됩니다.","u":"/ko/wiki/weapons/#w-toxic_stench","c":"무기","i":"/assets/icons/weapons/toxic_stench.png"},{"n":"용맹한 베기","d":"가장 가까운 적에게 호를 그리며 벱니다. 3번째 공격마다 360° 회전하며 치명타 확률 +100%.","u":"/ko/wiki/weapons/#w-valiant_slash","c":"무기","i":"/assets/icons/weapons/valiant_slash.png"},{"n":"야생의 돌풍","d":"적을 추적하는 돌풍을 일으킵니다. 공중에서 날린 돌풍은 2배의 피해를 줍니다.","u":"/ko/wiki/weapons/#w-wind","c":"무기","i":"/assets/icons/weapons/wind.png"},{"n":"돌 피부","d":"피부가 바위처럼 단단해져, 받는 피해를 줄이는 방어력을 얻습니다","u":"/ko/wiki/instincts/#i-armor_passive","c":"본능","i":"/assets/icons/instincts/armor_passive.png"},{"n":"야생의 반사신경","d":"공격 속도가 증가합니다","u":"/ko/wiki/instincts/#i-attack_speed_passive","c":"본능","i":"/assets/icons/instincts/attack_speed_passive.png"},{"n":"균형의 본능","d":"레벨마다 피해, 최대 체력, 이동 속도, 공격 속도를 한꺼번에 올립니다","u":"/ko/wiki/instincts/#i-balance_passive","c":"본능","i":"/assets/icons/instincts/balance_passive.png"},{"n":"혼돈의 본능","d":"레벨마다 무작위 능력치를 강화합니다. 희귀할수록 강하며, 전설이면 전용 본능의 2배입니다","u":"/ko/wiki/instincts/#i-chaos_passive","c":"본능","i":"/assets/icons/instincts/chaos_passive.png"},{"n":"예리한 눈","d":"치명타 확률이 증가합니다","u":"/ko/wiki/instincts/#i-crit_chance_passive","c":"본능","i":"/assets/icons/instincts/crit_chance_passive.png"},{"n":"사나운 이빨","d":"치명타 피해가 증가합니다","u":"/ko/wiki/instincts/#i-crit_damage_passive","c":"본능","i":"/assets/icons/instincts/crit_damage_passive.png"},{"n":"날카로운 송곳니","d":"모든 공격의 피해가 증가합니다","u":"/ko/wiki/instincts/#i-damage_passive","c":"본능","i":"/assets/icons/instincts/damage_passive.png"},{"n":"어둠의 낙인","d":"적이 더 많아지고 체력과 피해가 조금 늘어나지만, 더 많은 골드를 떨어뜨립니다","u":"/ko/wiki/instincts/#i-difficulty_passive","c":"본능","i":"/assets/icons/instincts/difficulty_passive.png"},{"n":"미끄러운 털","d":"적의 공격을 회피할 확률이 증가합니다","u":"/ko/wiki/instincts/#i-dodge_passive","c":"본능","i":"/assets/icons/instincts/dodge_passive.png"},{"n":"긴 도화선","d":"당신이 일으키는 효과의 지속 시간이 늘어납니다","u":"/ko/wiki/instincts/#i-duration_passive","c":"본능","i":"/assets/icons/instincts/duration_passive.png"},{"n":"조상의 본능","d":"적 처치 시 더 많은 경험치를 얻습니다","u":"/ko/wiki/instincts/#i-exp_passive","c":"본능","i":"/assets/icons/instincts/exp_passive.png"},{"n":"탐욕스러운 코","d":"적이 떨어뜨리는 골드가 증가합니다","u":"/ko/wiki/instincts/#i-gold_passive","c":"본능","i":"/assets/icons/instincts/gold_passive.png"},{"n":"젊은 피","d":"받는 모든 회복의 효과가 증가합니다","u":"/ko/wiki/instincts/#i-heal_passive","c":"본능","i":"/assets/icons/instincts/heal_passive.png"},{"n":"피의 갈증","d":"적에게서 생명력을 훔칩니다: 직접 공격할 때마다 회복합니다. 생명력 흡수 100%마다 공격당 체력 1 회복.","u":"/ko/wiki/instincts/#i-lifesteal_passive","c":"본능","i":"/assets/icons/instincts/lifesteal_passive.png"},{"n":"행운의 수염","d":"더 높은 등급의 보상이 나올 확률이 증가합니다","u":"/ko/wiki/instincts/#i-lucky_passive","c":"본능","i":"/assets/icons/instincts/lucky_passive.png"},{"n":"예민한 코","d":"더 먼 곳의 경험치 구슬을 끌어당깁니다","u":"/ko/wiki/instincts/#i-magnet_passive","c":"본능","i":"/assets/icons/instincts/magnet_passive.png"},{"n":"두꺼운 가죽","d":"최대 체력이 증가합니다","u":"/ko/wiki/instincts/#i-max_health_passive","c":"본능","i":"/assets/icons/instincts/max_health_passive.png"},{"n":"날쌘 발","d":"이동 속도가 증가합니다","u":"/ko/wiki/instincts/#i-movement_speed_passive","c":"본능","i":"/assets/icons/instincts/movement_speed_passive.png"},{"n":"야생의 추진력","d":"투사체가 더 빠르게, 더 멀리 날아갑니다","u":"/ko/wiki/instincts/#i-projectile_speed_passive","c":"본능","i":"/assets/icons/instincts/projectile_speed_passive.png"},{"n":"추가 투사체","d":"무기가 더 많은 투사체를 발사합니다. 칼날 털, 화염 방사기, 독성 악취에는 적용되지 않습니다.","u":"/ko/wiki/instincts/#i-quantity_passive","c":"본능","i":"/assets/icons/instincts/quantity_passive.png"},{"n":"꾸준한 심장박동","d":"매초 최대 체력의 일정 비율을 회복합니다","u":"/ko/wiki/instincts/#i-regen_passive","c":"본능","i":"/assets/icons/instincts/regen_passive.png"},{"n":"등껍질","d":"피해를 흡수하는 푸른 보호막을 얻습니다. 공격을 받지 않으면 재생됩니다","u":"/ko/wiki/instincts/#i-shield_passive","c":"본능","i":"/assets/icons/instincts/shield_passive.png"},{"n":"독 묻은 발톱","d":"상태 이상 적용 확률이 증가합니다. 100%를 넘으면 추가 중첩을 적용합니다","u":"/ko/wiki/instincts/#i-status_chance_passive","c":"본능","i":"/assets/icons/instincts/status_chance_passive.png"},{"n":"청소부의 본능","d":"상태 이상에 걸린 적에게 주는 피해가 증가합니다","u":"/ko/wiki/instincts/#i-status_damage_passive","c":"본능","i":"/assets/icons/instincts/status_damage_passive.png"},{"n":"가시 털","d":"털이 가시처럼 곤두섭니다: 당신에게 닿은 적은 최대 체력의 일부를 잃습니다. 가죽이 두꺼운 보스는 그 10분의 1만 잃습니다.","u":"/ko/wiki/instincts/#i-thorns_passive","c":"본능","i":"/assets/icons/instincts/thorns_passive.png"},{"n":"무성한 성장","d":"무기와 투사체의 크기가 커집니다","u":"/ko/wiki/instincts/#i-weapon_size_passive","c":"본능","i":"/assets/icons/instincts/weapon_size_passive.png"},{"n":"석호 민달팽이","d":"10초 동안 피해를 받지 않으면 초당 최대 체력의 1%를 회복합니다. 중첩마다 +1%.","u":"/ko/wiki/items/#it-babosa_laguna","c":"아이템","i":"/assets/icons/items/babosa_laguna.png"},{"n":"카피바라 간식","d":"적 처치 시 중첩당 1% 확률로 최대 체력의 5%를 회복하는 음식을 떨어뜨립니다.","u":"/ko/wiki/items/#it-bocado_capibar","c":"아이템","i":"/assets/icons/items/bocado_capibar.png"},{"n":"바람의 목도리","d":"공중에 있는 동안 주는 피해가 15% 증가합니다. 중첩마다 누적됩니다.","u":"/ko/wiki/items/#it-bufanda_viento","c":"아이템","i":"/assets/icons/items/bufanda_viento.png"},{"n":"가죽 망토","d":"중첩당 회피 확률 +5% (최대 95%).","u":"/ko/wiki/items/#it-capa_cuero","c":"아이템","i":"/assets/icons/items/capa_cuero.png"},{"n":"챔피언 벨트","d":"체력이 가득 찬 동안 피해량이 20% 증가합니다. 중첩마다 20%씩 추가됩니다.","u":"/ko/wiki/items/#it-cinturon_campeon","c":"아이템","i":"/assets/icons/items/cinturon_campeon.png"},{"n":"단조된 송곳니","d":"중첩마다 정예 적과 보스에게 주는 피해량이 25% 증가합니다.","u":"/ko/wiki/items/#it-colmillos_forjados","c":"아이템","i":"/assets/icons/items/colmillos_forjados.png"},{"n":"망원 조준경","d":"치명타 확률 +10% (피해 x2). 획득할 때마다 중첩됩니다.","u":"/ko/wiki/items/#it-critical_chance","c":"아이템","i":"/assets/icons/items/critical_chance.png"},{"n":"수정 방패","d":"3초 동안 피해를 받지 않으면 다음 공격을 완전히 흡수하는 보호막이 생성됩니다.","u":"/ko/wiki/items/#it-escudo_cristal","c":"아이템","i":"/assets/icons/items/escudo_cristal.png"},{"n":"부레옥잠 가시","d":"적중 시 4% 확률로 출혈을 부여합니다: 중첩마다 2초에 걸쳐 적중 피해의 100%를 줍니다. 출혈이 5개 쌓이면 터지며 남은 피해를 한