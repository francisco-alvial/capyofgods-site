[{"n":"遊玩指南","d":"操作、經驗值、升級、寶箱、建築、召喚首領以及亡魂大軍。","u":"/zh-tw/wiki/how-to-play/","c":"Wiki","i":"/assets/icons/characters/bob.png"},{"n":"角色","d":"12 隻可玩水豚：屬性、初始武器、被動與解鎖方式。","u":"/zh-tw/wiki/characters/","c":"Wiki","i":"/assets/icons/characters/caparzo.png"},{"n":"武器","d":"每一種自動武器的效果與解鎖方式。","u":"/zh-tw/wiki/weapons/","c":"Wiki","i":"/assets/icons/weapons/fireball.png"},{"n":"本能","d":"升級時可選的 26 種動物本能（被動）。","u":"/zh-tw/wiki/instincts/","c":"Wiki","i":"/assets/icons/instincts/armor_passive.png"},{"n":"道具","d":"依稀有度分類的寶箱與商店道具及其效果。","u":"/zh-tw/wiki/items/","c":"Wiki","i":"/assets/icons/items/lampara_encantada.png"},{"n":"首領","d":"每種攀登中的精英首領、樓層首領、任務首領與最終遭遇戰。","u":"/zh-tw/wiki/bosses/","c":"Wiki","i":"/assets/sprites/boss_devorador.png"},{"n":"敵人","d":"各生態的一般敵人及其行為。","u":"/zh-tw/wiki/enemies/","c":"Wiki","i":"/assets/sprites/enemy_eyeball.png"},{"n":"攀登","d":"三種攀登、生態、定時觸發的事件、難度與排行榜。","u":"/zh-tw/wiki/tower/","c":"Wiki","i":"/assets/sprites/enemy_sentinel_eye.png"},{"n":"成長與解鎖","d":"紅寶石、永久屬性、解鎖鏈以及完整任務列表。","u":"/zh-tw/wiki/progression/","c":"Wiki","i":"/assets/icons/items/lucky_bag.png"},{"n":"背景故事","d":"Sir Capy Drake 的傳說、赤紅群峰，以及名為 Capy of Gods 的競賽。","u":"/zh-tw/wiki/lore/","c":"Wiki","i":"/assets/sprites/boss_capy_demon_king.png"},{"n":"常見問題","d":"搶先體驗、價格、平台、語言、直播等等。","u":"/zh-tw/wiki/faq/","c":"Wiki","i":"/assets/brand/favicon.png"},{"n":"Bob","d":"偵探嗅覺","u":"/zh-tw/wiki/characters/#c-bob","c":"角色","i":"/assets/icons/characters/bob.png"},{"n":"C-Rex","d":"原始狂怒","u":"/zh-tw/wiki/characters/#c-c_rex","c":"角色","i":"/assets/icons/characters/c_rex.png"},{"n":"強尼","d":"硬化甲殼","u":"/zh-tw/wiki/characters/#c-caparzo","c":"角色","i":"/assets/icons/characters/caparzo.png"},{"n":"疾風船長","d":"順風","u":"/zh-tw/wiki/characters/#c-capytain_gale","c":"角色","i":"/assets/icons/characters/capytain_gale.png"},{"n":"Deadeye","d":"致命瞄準","u":"/zh-tw/wiki/characters/#c-deadeye","c":"角色","i":"/assets/icons/characters/deadeye.png"},{"n":"Dr. Plague","d":"灼熱高燒","u":"/zh-tw/wiki/characters/#c-dr_peste","c":"角色","i":"/assets/icons/characters/dr_peste.png"},{"n":"Gary","d":"生產線","u":"/zh-tw/wiki/characters/#c-gary","c":"角色","i":"/assets/icons/characters/gary.png"},{"n":"Lycap","d":"嗜血","u":"/zh-tw/wiki/characters/#c-lycap","c":"角色","i":"/assets/icons/characters/lycap.png"},{"n":"Sir Drake Jr.","d":"騎士的驕傲","u":"/zh-tw/wiki/characters/#c-sir_drake_jr","c":"角色","i":"/assets/icons/characters/sir_drake_jr.png"},{"n":"Skelly-san","d":"偶像狂熱","u":"/zh-tw/wiki/characters/#c-skelly_san","c":"角色","i":"/assets/icons/characters/skelly_san.png"},{"n":"火花","d":"超載","u":"/zh-tw/wiki/characters/#c-sparky","c":"角色","i":"/assets/icons/characters/sparky.png"},{"n":"Stinky","d":"揮之不去的臭味","u":"/zh-tw/wiki/characters/#c-stinky","c":"角色","i":"/assets/icons/characters/stinky.png"},{"n":"利刃毛皮","d":"豎起的毛皮光環，傷害靠近的一切","u":"/zh-tw/wiki/weapons/#w-aura","c":"武器","i":"/assets/icons/weapons/aura.png"},{"n":"爪擊橫掃","d":"朝最近的敵人撕裂扇形範圍。擊殺時有 5% 機率回復 1 點生命。","u":"/zh-tw/wiki/weapons/#w-claw_sweep","c":"武器","i":"/assets/icons/weapons/claw_sweep.png"},{"n":"劇毒口水","d":"吐出在敵人之間彈跳的毒液彈","u":"/zh-tw/wiki/weapons/#w-escupo","c":"武器","i":"/assets/icons/weapons/escupo.png"},{"n":"烈焰唾液","d":"發射火球燒灼怪物","u":"/zh-tw/wiki/weapons/#w-fireball","c":"武器","i":"/assets/icons/weapons/fireball.png"},{"n":"火焰噴射器","d":"噴出一道會轉向最近敵人的火焰，可能燒傷掃過的一切","u":"/zh-tw/wiki/weapons/#w-fireground","c":"武器","i":"/assets/icons/weapons/fireground.png"},{"n":"螢光棒","d":"擲出一根會減速、掉頭並飛回的棒子。去程與回程皆可命中。","u":"/zh-tw/wiki/weapons/#w-glow_stick","c":"武器","i":"/assets/icons/weapons/glow_stick.png"},{"n":"雷霆線圈","d":"對附近敵人召喚電擊","u":"/zh-tw/wiki/weapons/#w-lightning","c":"武器","i":"/assets/icons/weapons/lightning.png"},{"n":"章魚哨兵","d":"每 3 s 部署一座存活 5 s 的章魚哨兵，以你的屬性射擊附近敵人。","u":"/zh-tw/wiki/weapons/#w-octo_sentry","c":"武器","i":"/assets/icons/weapons/octo_sentry.png"},{"n":"狙擊槍","d":"發射貫穿一整排敵人的子彈。用滑鼠或右搖桿瞄準","u":"/zh-tw/wiki/weapons/#w-sniper","c":"武器","i":"/assets/icons/weapons/sniper.png"},{"n":"毒臭","d":"移動時在身後留下臭氣雲。雲會攻擊其中的敵人並可能使其中毒；中毒可無限疊加。","u":"/zh-tw/wiki/weapons/#w-toxic_stench","c":"武器","i":"/assets/icons/weapons/toxic_stench.png"},{"n":"英勇斬","d":"朝最近的敵人揮出弧形斬擊。每第 3 擊會旋轉 360° 並獲得 +100% 暴擊機率。","u":"/zh-tw/wiki/weapons/#w-valiant_slash","c":"武器","i":"/assets/icons/weapons/valiant_slash.png"},{"n":"狂野疾風","d":"吹出追蹤敵人的疾風。在空中發射的疾風造成雙倍傷害。","u":"/zh-tw/wiki/weapons/#w-wind","c":"武器","i":"/assets/icons/weapons/wind.png"},{"n":"石膚","d":"你的皮膚硬如岩石：獲得可減少所受傷害的護甲","u":"/zh-tw/wiki/instincts/#i-armor_passive","c":"本能","i":"/assets/icons/instincts/armor_passive.png"},{"n":"野性反射","d":"提高攻擊速度","u":"/zh-tw/wiki/instincts/#i-attack_speed_passive","c":"本能","i":"/assets/icons/instincts/attack_speed_passive.png"},{"n":"平衡本能","d":"每級同時提升傷害、最大生命、移動速度與攻擊速度","u":"/zh-tw/wiki/instincts/#i-balance_passive","c":"本能","i":"/assets/icons/instincts/balance_passive.png"},{"n":"混沌本能","d":"每級隨機提升一項屬性。稀有度越高越強：傳說時是其專屬本能的兩倍","u":"/zh-tw/wiki/instincts/#i-chaos_passive","c":"本能","i":"/assets/icons/instincts/chaos_passive.png"},{"n":"銳眼","d":"提高打出暴擊的機率","u":"/zh-tw/wiki/instincts/#i-crit_chance_passive","c":"本能","i":"/assets/icons/instincts/crit_chance_passive.png"},{"n":"兇猛撕咬","d":"提高暴擊傷害","u":"/zh-tw/wiki/instincts/#i-crit_damage_passive","c":"本能","i":"/assets/icons/instincts/crit_damage_passive.png"},{"n":"利牙","d":"提高所有攻擊的傷害","u":"/zh-tw/wiki/instincts/#i-damage_passive","c":"本能","i":"/assets/icons/instincts/damage_passive.png"},{"n":"黑暗印記","d":"敵人更多、生命更高、傷害略增，但掉落更多金幣","u":"/zh-tw/wiki/instincts/#i-difficulty_passive","c":"本能","i":"/assets/icons/instincts/difficulty_passive.png"},{"n":"滑溜毛皮","d":"提高閃避敵人攻擊的機率","u":"/zh-tw/wiki/instincts/#i-dodge_passive","c":"本能","i":"/assets/icons/instincts/dodge_passive.png"},{"n":"長引信","d":"延長你造成的效果持續時間","u":"/zh-tw/wiki/instincts/#i-duration_passive","c":"本能","i":"/assets/icons/instincts/duration_passive.png"},{"n":"祖傳本能","d":"每個敵人獲得更多經驗值","u":"/zh-tw/wiki/instincts/#i-exp_passive","c":"本能","i":"/assets/icons/instincts/exp_passive.png"},{"n":"貪婪鼻子","d":"提高敵人掉落的金幣","u":"/zh-tw/wiki/instincts/#i-gold_passive","c":"本能","i":"/assets/icons/instincts/gold_passive.png"},{"n":"年輕之血","d":"你受到的所有治療效果更佳","u":"/zh-tw/wiki/instincts/#i-heal_passive","c":"本能","i":"/assets/icons/instincts/heal_passive.png"},{"n":"嗜血","d":"你從敵人身上竊取生命：每次直接攻擊都會治療你。每100%生命竊取 = 每次命中回復1點生命。","u":"/zh-tw/wiki/instincts/#i-lifesteal_passive","c":"本能","i":"/assets/icons/instincts/lifesteal_passive.png"},{"n":"幸運鬍鬚","d":"提高獲得高稀有度獎勵的機率","u":"/zh-tw/wiki/instincts/#i-lucky_passive","c":"本能","i":"/assets/icons/instincts/lucky_passive.png"},{"n":"靈敏嗅覺","d":"從更遠處吸引經驗值球","u":"/zh-tw/wiki/instincts/#i-magnet_passive","c":"本能","i":"/assets/icons/instincts/magnet_passive.png"},{"n":"厚皮","d":"提高最大生命值","u":"/zh-tw/wiki/instincts/#i-max_health_passive","c":"本能","i":"/assets/icons/instincts/max_health_passive.png"},{"n":"迅捷爪掌","d":"提高移動速度","u":"/zh-tw/wiki/instincts/#i-movement_speed_passive","c":"本能","i":"/assets/icons/instincts/movement_speed_passive.png"},{"n":"狂野衝勁","d":"你的投射物飛得更快、更遠","u":"/zh-tw/wiki/instincts/#i-projectile_speed_passive","c":"本能","i":"/assets/icons/instincts/projectile_speed_passive.png"},{"n":"額外投射物","d":"你的武器會發射更多投射物。對利刃毛皮、火焰噴射器及毒臭無效。","u":"/zh-tw/wiki/instincts/#i-quantity_passive","c":"本能","i":"/assets/icons/instincts/quantity_passive.png"},{"n":"穩定心跳","d":"每秒恢復一定比例的最大生命","u":"/zh-tw/wiki/instincts/#i-regen_passive","c":"本能","i":"/assets/icons/instincts/regen_passive.png"},{"n":"甲殼","d":"獲得可吸收傷害的藍色護盾，未受攻擊時會再生","u":"/zh-tw/wiki/instincts/#i-shield_passive","c":"本能","i":"/assets/icons/instincts/shield_passive.png"},{"n":"淬毒之爪","d":"提高施加狀態效果的機率；超過 100% 時會施加額外層數","u":"/zh-tw/wiki/instincts/#i-status_chance_passive","c":"本能","i":"/assets/icons/instincts/status_chance_passive.png"},{"n":"食腐本能","d":"提高對身上有狀態效果的敵人造成的傷害","u":"/zh-tw/wiki/instincts/#i-status_damage_passive","c":"本能","i":"/assets/icons/instincts/status_damage_passive.png"},{"n":"尖刺毛皮","d":"你的毛皮豎起尖刺：碰觸你的敵人會失去部分最大生命。首領皮粗肉厚，只損失十分之一。","u":"/zh-tw/wiki/instincts/#i-thorns_passive","c":"本能","i":"/assets/icons/instincts/thorns_passive.png"},{"n":"瘋長","d":"讓你的武器與投射物變得更大","u":"/zh-tw/wiki/instincts/#i-weapon_size_passive","c":"本能","i":"/assets/icons/instincts/weapon_size_passive.png"},{"n":"潟湖蛞蝓","d":"10 秒未受到傷害後，每秒回復 1% 最大生命值。每層堆疊再 +1%。","u":"/zh-tw/wiki/items/#it-babosa_laguna","c":"道具","i":"/assets/icons/items/babosa_laguna.png"},{"n":"水豚點心","d":"擊殺時每層疊加有 1% 機率掉落食物，回復你最大生命的 5%。","u":"/zh-tw/wiki/items/#it-bocado_capibar","c":"道具","i":"/assets/icons/items/bocado_capibar.png"},{"n":"疾風圍巾","d":"在空中時傷害提高 15%。每層堆疊皆可累積。","u":"/zh-tw/wiki/items/#it-bufanda_viento","c":"道具","i":"/assets/icons/items/bufanda_viento.png"},{"n":"皮革披風","d":"每層疊加提供 +5% 閃避機率，上限 95%。","u":"/zh-tw/wiki/items/#it-capa_cuero","c":"道具","i":"/assets/icons/items/capa_cuero.png"},{"n":"冠軍腰帶","d":"生命值全滿時造成的傷害提高 20%。每層堆疊再增加 20%。","u":"/zh-tw/wiki/items/#it-cinturon_campeon","c":"道具","i":"/assets/icons/items/cinturon_campeon.png"},{"n":"鍛造獠牙","d":"每層堆疊使你對菁英敵人與首領的傷害提高 25%。","u":"/zh-tw/wiki/items/#it-colmillos_forjados","c":"道具","i":"/assets/icons/items/colmillos_forjados.png"},{"n":"望遠瞄準鏡","d":"+10% 暴擊機率（x2 傷害）。每次拾取可疊加。","u":"/zh-tw/wiki/items/#it-critical_chance","c":"道具","i":"/assets/icons/items/critical_chance.png"},{"n":"水晶護盾","d":"3 秒未受到傷害後會形成護盾，完全吸收下一次攻擊。","u":"/zh-tw/wiki/items/#it-escudo_cristal","c":"道具","i":"/assets/icons/items/escudo_cristal.png"},{"n":"布袋蓮之刺","d":"命中時有 4% 機率造成流血：每層堆疊在 2 秒內造成該次攻擊 100% 的傷害。累積 5 層流血時會爆發，一次造成剩餘傷害。","u":"/zh-tw/wiki/items/#it-espina_aguape","c":"道具","i":"/assets/icons/items/espina_aguape.png"},{"n":"攜帶式彈簧床","d":"額外獲得 +1 次跳躍。每次拾取可疊加。","u":"/zh-tw/wiki/items/#it-extra_jump","c":"道具","i":"/assets/icons/items/extra_jump.png"},{"n":"伏擊之爪","d":"對生命值高於 90% 的敵人造成 +20% 傷害。每次拾取可疊加。","u":"/zh-tw/wiki/items/#it-high_hp_damage","c":"道具","i":"/assets/icons/items/high_hp_damage.png"},{"n":"幸運袋","d":"+25% 金幣獲取量。每次拾取可疊加。","u":"/zh-tw/wiki/items/#it-lucky_bag","c":"道具","i":"/assets/icons/items/lucky_bag.png"},{"n":"發酵芒果","d":"命中時有 3% 機率引發爆炸，對敵人周圍區域造成你 80% 的傷害。","u":"/zh-tw/wiki/items/#it-mango_fermentado","c":"道具","i":"/assets/icons/items/mango_fermentado.png"},{"n":"木槌","d":"命中時有 5% 機率擊退敵人。對首領無效。","u":"/zh-tw/wiki/items/#it-martillo_madera","c":"道具","i":"/assets/icons/items/martillo_madera.png"},{"n":"爆裂瑪黛茶","d":"每層堆疊使衝刺冷卻時間減少 15%。","u":"/zh-tw/wiki/items/#it-mate_explosivo","c":"道具","i":"/assets/icons/items/mate_explosivo.png"},{"n":"偽幣","d":"+10% 機率免費開啟寶箱（效果遞減）。免費寶箱不會提高下一個寶箱的價格。","u":"/zh-tw/wiki/items/#it-moneda_falsa","c":"道具","i":"/assets/icons/items/moneda_falsa.png"},{"n":"藍色耳環","d":"每層疊加使攻擊速度提高 10%。","u":"/zh-tw/wiki/items/#it-pendientes_azules","c":"道具","i":"/assets/icons/items/pendientes_azules.png"},{"n":"水豚蹄","d":"每層疊加使移動速度提高 15%。","u":"/zh-tw/wiki/items/#it-pezunas_capibara","c":"道具","i":"/assets/icons/items/pezunas_capibara.png"},{"n":"苦草","d":"擊殺敵人時永久獲得 5 點最大生命值。每層堆疊使上限額外提高 100 點生命值。","u":"/zh-tw/wiki/items/#it-yerba_mala","c":"道具","i":"/assets/icons/items/yerba_mala.png"},{"n":"說話的頭","d":"每秒持續失去 1% 最大生命值，但總傷害加倍。","u":"/zh-tw/wiki/items/#it-cabeza_parlante","c":"道具","i":"/assets/icons/items/cabeza_parlante.png"},{"n":"水豚尾巴","d":"你的攻擊有 10% 機率暈眩被擊中的敵人。對首領無效。","u":"/zh-tw/wiki/items/#it-cola_capibara","c":"道具","i":"/assets/icons/items/cola_capibara.png"},{"n":"凍結手指","d":"連續擊殺 20 名敵人且未受傷時，在你所在位置召喚冰雪風暴，對敵人造成傷害 5 秒。範圍隨武器大小增加，但效益遞減。受到傷害會重置計數。","u":"/zh-tw/wiki/items/#it-dedo_congelado","c":"道具","i":"/assets/icons/items/dedo_congelado.png"},{"n":"迷幻蘑菇","d":"擊殺菁英敵人時進入狂熱狀態 4 秒：+50% 攻擊速度與 +100% 移動速度。","u":"/zh-tw/wiki/items/#it-hongo_alucinogeno","c":"道具","i":"/assets/icons/items/hongo_alucinogeno.png"},{"n":"玩家護目鏡","d":"每損失 1% 生命值，傷害提高 1%。每層堆疊再提高 1%。","u":"/zh-tw/wiki/items/#it-lentes_gamer","c":"道具","i":"/assets/icons/items/lentes_gamer.png"},{"n":"葉片眼鏡","d":"受任何狀態效果影響的敵人，每層堆疊多受到 60% 傷害。","u":"/zh-tw/wiki/items/#it-lentes_hojas","c":"道具","i":"/assets/icons/items/lentes_hojas.png"},{"n":"魔法飛彈","d":"擊殺敵人時發射 2 枚追蹤敵人的魔法飛彈，命中或存續時間結束時爆炸。","u":"/zh-tw/wiki/items/#it-misil_magico","c":"道具","i":"/assets/icons/items/misil_magico.png"},{"n":"屬性吸收槍","d":"擊殺菁英敵人時，總傷害加倍，持續 4 秒。","u":"/zh-tw/wiki/items/#it-pistola_absorbe_stats","c":"道具","i":"/assets/icons/items/pistola_absorbe_stats.png"},{"n":"碎裂稜鏡","d":"你的武器獲得 +1 數量。每次拾取皆可疊加。","u":"/zh-tw/wiki/items/#it-prisma_trizado","c":"道具","i":"/assets/icons/items/prisma_trizado.png"},{"n":"貪吃吸塵器","d":"每 20 秒將地圖上所有經驗球吸向你。每層堆疊縮短 3 秒（最少 8 秒）。","u":"/zh-tw/wiki/items/#it-aspiradora_glotona","c":"道具","i":"/assets/icons/items/aspiradora_glotona.png"},{"n":"音樂 CD","d":"5 秒內擊殺 20 名敵人可啟動迪斯可模式：每次擊殺都會從你的位置朝隨機敵人發射一張 CD。","u":"/zh-tw/wiki/items/#it-cd_musica","c":"道具","i":"/assets/icons/items/cd_musica.png"},{"n":"靈魂水晶","d":"每擊殺 100 名敵人為水晶充能。充滿後，生命值低於 50% 時水晶碎裂，回復 30% 最大生命值（最多每 20 秒一次）。疊加越多，充能越快。","u":"/zh-tw/wiki/items/#it-cristal_alma","c":"道具","i":"/assets/icons/items/cristal_alma.png"},{"n":"怪異藥水","d":"所有治療效果加倍。每層堆疊使效果再次加倍。","u":"/zh-tw/wiki/items/#it-extrana_pocima","c":"道具","i":"/assets/icons/items/extrana_pocima.png"},{"n":"黑貓","d":"每局一次，生命值降至 0 時以 15% 最大生命值復活，並獲得 5 秒無敵。","u":"/zh-tw/wiki/items/#it-gato_negro","c":"道具","i":"/assets/icons/items/gato_negro.png"},{"n":"附魔神燈","d":"你的道具的命中機率效果額外判定 1 次。每層堆疊再多判定 1 次，最多 3 次。","u":"/zh-tw/wiki/items/#it-lampara_encantada","c":"道具","i":"/assets/icons/items/lampara_encantada.png"},{"n":"薩滿面具","d":"每次治療時自動發射一顆魔法骷髏，造成治療量 250% 的傷害。","u":"/zh-tw/wiki/items/#it-mascara_chaman","c":"道具","i":"/assets/icons/items/mascara_chaman.png"},{"n":"沙包","d":"連續攻擊同一敵人時，每層每次命中額外增加 +0.1% 傷害。上限 +200%，每多一層上限再增加 +200%。攻擊其他敵人會重置計數。","u":"/zh-tw/wiki/items/#it-saco_boxeo","c":"道具","i":"/assets/icons/items/saco_boxeo.png"},{"n":"食人植物種子","d":"擊殺敵人時有 7% 機率召喚友方食人植物，攻擊附近敵人 30 秒。","u":"/zh-tw/wiki/items/#it-semillas_carnivoras","c":"道具","i":"/assets/icons/items/semillas_carnivoras.png"},{"n":"木戒指","d":"暴擊使攻擊速度提高 10%，持續 2 秒，最多 30%。","u":"/zh-tw/wiki/items/#it-anillo_madera","c":"道具","i":"/assets/icons/items/anillo_madera.png"},{"n":"黏稠黏液","d":"命中時有 20% 機率使敵人減速 40%，持續 1 秒。對首領無效。","u":"/zh-tw/wiki/items/#it-baba_viscosa","c":"道具","i":"/assets/icons/items/baba_viscosa.png"},{"n":"稻草斗篷","d":"在空中時，每層堆疊使受到的傷害減少 20%，最多 80%。","u":"/zh-tw/wiki/items/#it-capa_paja","c":"道具","i":"/assets/icons/items/capa_paja.png"},{"n":"衝刺彈匣","d":"衝刺次數 +1。每層堆疊皆可累積，最多 4 次。","u":"/zh-tw/wiki/items/#it-cargador_dash","c":"道具","i":"/assets/icons/items/cargador_dash.png"},{"n":"電線","d":"命中時有 5% 機率在附近敵人之間產生連鎖閃電。","u":"/zh-tw/wiki/items/#it-cordel_electrico","c":"道具","i":"/assets/icons/items/cordel_electrico.png"},{"n":"河狸鼠牙齒","d":"每層堆疊提供 +10% 生命竊取。","u":"/zh-tw/wiki/items/#it-dientes_coipu","c":"道具","i":"/assets/icons/items/dientes_coipu.png"},{"n":"電擊插頭","d":"受到傷害時釋放電擊，對附近敵人造成你最大生命值 10% 的傷害。每層堆疊 +5% 並擴大範圍。冷卻 1 秒。","u":"/zh-tw/wiki/items/#it-enchufe_electrico","c":"道具","i":"/assets/icons/items/enchufe_electrico.png"},{"n":"鬼火","d":"擊殺敵人時有 5% 機率召喚鬼火，每秒造成 40 點傷害，持續 5 秒。","u":"/zh-tw/wiki/items/#it-fuego_fatuo","c":"道具","i":"/assets/icons/items/fuego_fatuo.png"},{"n":"爆頭","d":"生命值不高於 5% 的敵人（包括菁英）受到任何攻擊都會立即死亡。對首領無效。","u":"/zh-tw/wiki/items/#it-headshot","c":"道具","i":"/assets/icons/items/headshot.png"},{"n":"橡膠球","d":"命中時有 10% 機率發射一顆自動追擊敵人的橡膠球。","u":"/zh-tw/wiki/items/#it-pelota_goma","c":"道具","i":"/assets/icons/items/pelota_goma.png"},{"n":"踐踏","d":"從高處落地時重擊地面，傷害附近的敵人。落差越高傷害越高（最多 x4）。每層堆疊 +100% 傷害並擴大範圍。","u":"/zh-tw/wiki/items/#it-pisoton","c":"道具","i":"/assets/icons/items/pisoton.png"},{"n":"武器欄位","d":"解鎖額外欄位，可多攜帶一把武器（最多 2 個）。","u":"/zh-tw/wiki/progression/#a-weapon_slots","c":"成長與解鎖","i":""},{"n":"本能欄位","d":"解鎖額外欄位，可多攜帶一個動物本能（最多 2 個）。","u":"/zh-tw/wiki/progression/#a-instinct_slots","c":"成長與解鎖","i":""},{"n":"額外數量","d":"每級所有武器 +1 數量。","u":"/zh-tw/wiki/progression/#a-num_projectiles","c":"成長與解鎖","i":""},{"n":"金幣","d":"每級拾取的金幣 +10%。","u":"/zh-tw/wiki/progression/#a-coins","c":"成長與解鎖","i":""},{"n":"初始生命","d":"每級最大生命值 +10%。","u":"/zh-tw/wiki/progression/#a-max_health","c":"成長與解鎖","i":""},{"n":"傷害","d":"每級傷害 +10%。","u":"/zh-tw/wiki/progression/#a-damage","c":"成長與解鎖","i":""},{"n":"護甲","d":"每級護甲 +10。","u":"/zh-tw/wiki/progression/#a-armor","c":"成長與解鎖","i":""},{"n":"攻擊速度","d":"每級攻擊速度 +5%。","u":"/zh-tw/wiki/progression/#a-attack_speed","c":"成長與解鎖","i":""},{"n":"效果持續時間","d":"每級效果（火焰、燃燒）持續時間 +10%。","u":"/zh-tw/wiki/progression/#a-effect_duration","c":"成長與解鎖","i":""},{"n":"西瓜磁鐵","d":"每級經驗球拾取範圍 +25%。","u":"/zh-tw/wiki/progression/#a-xp_magnet","c":"成長與解鎖","i":""},{"n":"武器大小","d":"每級武器大小 +6%。","u":"/zh-tw/wiki/progression/#a-weapon_size","c":"成長與解鎖","i":""},{"n":"投射物速度","d":"每級投射物速度 +10%。","u":"/zh-tw/wiki/progression/#a-projectile_speed","c":"成長與解鎖","i":""},{"n":"移動速度","d":"每級移動速度 +8%。","u":"/zh-tw/wiki/progression/#a-movement_speed","c":"成長與解鎖","i":""},{"n":"幸運","d":"每級初始幸運 +0.25。","u":"/zh-tw/wiki/progression/#a-luck","c":"成長與解鎖","i":""},{"n":"經驗值","d":"每級獲得的經驗值 +8%。","u":"/zh-tw/wiki/progression/#a-exp","c":"成長與解鎖","i":""},{"n":"紅寶石掉落","d":"提高一般敵人掉落紅寶石的機率，以及菁英敵人與首領掉落的數量。","u":"/zh-tw/wiki/progression/#a-rubies","c":"成長與解鎖","i":""},{"n":"復活","d":"死亡時復活一次（最多 2 次）。","u":"/zh-tw/wiki/progression/#a-revive","c":"成長與解鎖","i":""},{"n":"重骰","d":"重骰升級選項（每級 1 次）。","u":"/zh-tw/wiki/progression/#a-reroll","c":"成長與解鎖","i":""},{"n":"捨棄武器","d":"在本局中從選項池捨棄一把武器或一個本能（每級 1 次）。","u":"/zh-tw/wiki/progression/#a-ban_weapon","c":"成長與解鎖","i":""},{"n":"捨棄道具","d":"在本局中開啟寶箱時捨棄一個道具（每級 1 次）。","u":"/zh-tw/wiki/progression/#a-ban_item","c":"成長與解鎖","i":""},{"n":"開關","d":"可以關閉已購買的武器、本能和道具,讓它們不會出現在你的對局中。初始內容無法關閉。","u":"/zh-tw/wiki/progression/#a-toggler","c":"成長與解鎖","i":""},{"n":"修格斯","d":"無形之恐 會在你身邊瞬移、直線衝撞穿過你的飛行怪物。衝刺前先看清牠的前搖。","u":"/zh-tw/wiki/bosses/#b-boss-shoggoth","c":"首領","i":"/assets/sprites/boss_shoggoth.png"},{"n":"虛空女神","d":"虛空之女 能預判你閃避的方向，把手掌法術直接砸在那裡，接著放出四發散射彈。","u":"/zh-tw/wiki/bosses/#b-boss-voidborn-goddes","c":"首領","i":"/assets/sprites/boss_voidborn_goddes.png"},{"n":"虛空召喚者","d":"深淵先驅 在競技場中四處瞬移，輪流施放黑暗火焰、雷射和從地面竄出的觸手。","u":"/zh-tw/wiki/bosses/#b-boss-voidcaller","c":"首領","i":"/assets/sprites/boss_voidcaller.png"},{"n":"C-Rex","d":" 接受幽靈水豚的請求並摧毀方尖碑後出現。擊敗牠即可開啟 C-Rex 的解鎖鏈。","u":"/zh-tw/wiki/bosses/#b-boss-c-rex","c":"首領","i":"/assets/sprites/boss_c_rex.png"},{"n":"森林巨鯨","d":"深林歌者 一頭會飛的鯨魚，會留下強化附近敵人的塵霧，發射有預警的飛鏢，並蓄力射出一顆緩慢的能量球。","u":"/zh-tw/wiki/bosses/#b-boss-hada","c":"首領","i":"/assets/sprites/boss_hada.png"},{"n":"螳螂","d":"苔蘚收割者 一隻巨型螳螂，輪流使用三種攻擊：近身突刺、在地面標出落點的跳躍重擊，以及三把刀刃的錐形斬擊。","u":"/zh-tw/wiki/bosses/#b-boss-mantis","c":"首領","i":"/assets/sprites/boss_mantis.png"},{"n":"肥胖植物","d":"沼澤饕餮 一株巨大的食人植物，會在你附近紮根。施放帶毒的孢子環、酸雨和一顆緩慢追蹤的酸液球。","u":"/zh-tw/wiki/bosses/#b-boss-planta-gorda","c":"首領","i":"/assets/sprites/boss_planta_gorda.png"},{"n":"死亡使者","d":"末息信使 每隔幾秒就瞬移到視野內的一座平台，揮砍、放出黑暗波，並在你腳下召出傳送門之手。","u":"/zh-tw/wiki/bosses/#b-boss-bringer-of-death","c":"首領","i":"/assets/sprites/boss_bringer_of_death.png"},{"n":"骸骨輪","d":"碎骨磨坊 一個滾動的骨頭輪。連續五次幽靈衝刺，還有一記從天而降、砸向你腳下標記的腹部重壓。","u":"/zh-tw/wiki/bosses/#b-boss-bone-wheel","c":"首領","i":"/assets/sprites/boss_bone_wheel.png"},{"n":"死神","d":"無人能逃者 從上方和下方把鐮刀像迴力鏢一樣甩出，朝你俯衝，並召喚骷髏弓箭手。","u":"/zh-tw/wiki/bosses/#b-boss-death","c":"首領","i":"/assets/sprites/boss_death.png"},{"n":"Skelly-san","d":" 歸還被撕破的旗幟後，牠會從粉紅色大門中現身。擊敗牠即可開啟 Skelly-san 的解鎖鏈。","u":"/zh-tw/wiki/bosses/#b-boss-skelly-san","c":"首領","i":"/assets/sprites/boss_skelly_san.png"},{"n":"暴龍迪諾","d":"冰河時代之王 一頭巨型恐龍，會在半空中定格再腹部猛砸，以幽靈衝刺橫越房間，並召喚讓天空落下球體的旗幟。","u":"/zh-tw/wiki/bosses/#b-boss-dino-rex","c":"首領","i":"/assets/sprites/boss_dino_rex.png"},{"n":"企鵝胖古","d":"冰川帝王 一隻戴墨鏡的企鵝：跳躍啄擊、依序落下的冰塊，以及橫掃的光束。","u":"/zh-tw/wiki/bosses/#b-boss-pengu","c":"首領","i":"/assets/sprites/boss_pengu.png"},{"n":"Lisa","d":"冰潮女巫 一位會飛的女術士，擁有五種法術：上升的泡泡、水之爆炸、從地面冒出的頭顱、不斷合攏的冰牆和墜落的冰刺。","u":"/zh-tw/wiki/bosses/#b-boss-lisa","c":"首領","i":"/assets/sprites/boss_lisa.png"},{"n":"雪怪","d":"群峰之懼 當你試圖救出困在雪中的攀登者時到來。拋出弧線雪球，跳躍落地時掀起一道冰浪。","u":"/zh-tw/wiki/bosses/#b-boss-yeti","c":"首領","i":"/assets/sprites/boss_yeti.png"},{"n":"惡魔武士","d":"無主之刃 三連斬組合技，每一刀都伴隨衝刺，外加跳躍斬擊。生命值降到一半時會發出怒吼、點燃刀刃，變得更快更耐打。","u":"/zh-tw/wiki/bosses/#b-boss-demon-samurai","c":"首領","i":"/assets/sprites/boss_demon_samurai.png"},{"n":"傀儡 H","d":"石之傀儡 一具漂浮的石之傀儡，閉上的眼睛會透露下一個法術：合攏的岩牆、在你腳下升起的石柱，或從天而降的水晶拳頭。","u":"/zh-tw/wiki/bosses/#b-boss-puppet-h","c":"首領","i":"/assets/sprites/boss_puppet_h.png"},{"n":"Bertha","d":"沙漠之斧 一個拿斧頭的巨型哥布林：沉重的連擊、向前掀起大地噴發的踐踏、跳躍猛砸，以及持續五秒的龍捲風。","u":"/zh-tw/wiki/bosses/#b-boss-bertha","c":"首領","i":"/assets/sprites/boss_bertha.png"},{"n":"摩薩格","d":"灰燼領主 原地紮根，向前噴出巨大的火焰，在你周圍掀起火焰龍捲風，並在頭頂蓄力引爆。","u":"/zh-tw/wiki/bosses/#b-boss-morthag","c":"首領","i":"/assets/sprites/boss_morthag.png"},{"n":"惡魔史萊姆","d":"活體黑焰 起初是一隻擁有獨立生命條、蹦蹦跳跳的史萊姆。接著化身為拿著砍刀的惡魔，使出三連跳和黑色火焰。","u":"/zh-tw/wiki/bosses/#b-boss-demon-slime","c":"首領","i":"/assets/sprites/boss_demon_slime.png"},{"n":"Megumi","d":"蠑螈女巫 一位火蜥蜴女巫，在房間中疾奔，施放黑洞、火焰龍捲風和火球。每施放幾個法術，她的火蜥蜴就會化為巨龍，射出貫穿整個關卡的光束。","u":"/zh-tw/wiki/bosses/#b-boss-megumi","c":"首領","i":"/assets/sprites/boss_megumi.png"},{"n":"吞噬者","d":" 在第 3 層之後的封印房間中等待，由你必須站上去的鮮血之心守護。牠會偷走你的道具，並在你傷到牠時歸還。衝撞、口中雷射和之字形猛撲。","u":"/zh-tw/wiki/bosses/#b-boss-devorador","c":"首領","i":"/assets/sprites/boss_devorador.png"},{"n":"吞噬者之母","d":" 在吞噬者倒下時到來。更多的心臟、雙重雷射，還能生出更小的吞噬者。擊敗她即可完成前 300 層。","u":"/zh-tw/wiki/bosses/#b-boss-devorador-madre","c":"首領","i":"/assets/sprites/boss_devorador_madre.png"},{"n":"Morrigal，最後的守夜人","d":" 一名擁有兩條生命條的黑暗騎士，會偷走你的武器，並在戰鬥中逐一歸還。每種攻擊都有物理版本，變身後還有爆炸版本。守夜之焰讓牠始終受到護盾保護。","u":"/zh-tw/wiki/bosses/#b-boss-morrigal","c":"首領","i":"/assets/sprites/boss_morrigal.png"},{"n":"卡皮魔王","d":" 召喚塔頂所有首領的那一位，每兩分鐘召喚一名。在每個關卡盡頭的管風琴前，以光之牢籠、脈衝和雷射應戰，然後經由傳送門撤退。牠在最高處的王座上等待。","u":"/zh-tw/wiki/bosses/#b-boss-capy-demon-king","c":"首領","i":"/assets/sprites/boss_capy_demon_king.png"},{"n":"眼球","d":"飛行追擊者。能穿牆，接觸造成傷害。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_eyeball.png"},{"n":"蚊子","d":"飛行衝刺者。先懸停，再從你身旁猛撲而過。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_mosquito.png"},{"n":"定時炸彈","d":"飛行自爆者。倒數 3、2、1 後在範圍內爆炸。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_time_bomb.png"},{"n":"法師邪教徒","d":"在平台間行走，每隔幾秒施放一發投射物。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_mage_cultist.png"},{"n":"刺客邪教徒","d":"速度很快的近戰邪教徒。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_assassin_cultist.png"},{"n":"巨型邪教徒","d":"緩慢又沉重的近戰邪教徒。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_big_cultist.png"},{"n":"蘑菇","d":"近戰追擊者，會像投射物一樣朝你飛撲。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_mushroom.png"},{"n":"跳跳蛙","d":"到處蹦跳，從遠處用舌頭攻擊你。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_frogger.png"},{"n":"甲蟲","d":"飛行追擊者。接觸造成傷害。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_bug.png"},{"n":"巨型蒼蠅","d":"飛行衝刺者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_giant_fly.png"},{"n":"蜜蜂","d":"飛近之後，化成一支筆直加速的飛鏢射向你。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_bee.png"},{"n":"水母蘑菇","d":"毒性自爆者。不斷膨脹、變綠，然後炸出毒霧。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_jelly_mushroom.png"},{"n":"火焰辣椒","d":"有四種顏色的遠程施法者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_fire_pepper.png"},{"n":"邪惡藤蔓","d":"第 5 分鐘的事件：食人藤蔓在整座塔中竄起。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_evil_vine.png"},{"n":"白骨角鬥士","d":"近戰，帶有突刺與短距離衝刺。攻擊距離比看起來更遠。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_bones_gladiator.png"},{"n":"黑暗騎士","d":"重型近戰：兩次揮砍，每次都伴隨長距離衝刺。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_dark_knight.png"},{"n":"感染爆破者","d":"坦克型自爆者，衝到你面前炸開，就算你先殺了牠也照樣爆炸。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_infected_exploder.png"},{"n":"Beholder","d":"飛行追擊者，會短距離前撲咬人。","u":"/zh-tw/wiki/enemies/#e-beholder","c":"敵人","i":"/assets/sprites/enemy_beholder.png"},{"n":"鮮血之龍","d":"衝向牠開始衝刺那一刻你所在的位置，靠近時會用爪子撕抓。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_blood_dragon.png"},{"n":"BatZ","d":"從不追擊的遠程飛行者。以五隻為一隊出現。","u":"/zh-tw/wiki/enemies/#e-batz","c":"敵人","i":"/assets/sprites/enemy_batz.png"},{"n":"哨兵之眼","d":"在固定高度巡邏。如果牠看到你並撐過五秒，就會觸發眼群：滿是眼睛的紅色通道橫越整座塔。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_sentinel_eye.png"},{"n":"冰霜魔像","d":"擁有兩種不同攻擊的重型近戰。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_ice_golem.png"},{"n":"幻影騎士","d":"使用新月斬的靈活近戰。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_phantom_knight.png"},{"n":"水之精魂","d":"飛行追擊者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_water_wisp.png"},{"n":"收割者","d":"速度很快的飛行追擊者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_reaper.png"},{"n":"Imp","d":"保持距離並發射弩箭的遠程飛行者。","u":"/zh-tw/wiki/enemies/#e-imp","c":"敵人","i":"/assets/sprites/enemy_imp.png"},{"n":"冬狼","d":"在咒語下沉睡，直到你靠近。只會在一個支線任務中出現。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_winter_wolf.png"},{"n":"燈神盜賊","d":"使用鐮刀斬擊的快速近戰。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_djinn_bandit.png"},{"n":"赤紅食人魔","d":"沉重的武士刀斬擊。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_red_ogre.png"},{"n":"黃蜂","d":"飛行追擊者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_wasp.png"},{"n":"Oculothorax","d":"咬一口就跑，再咬一口再跑。","u":"/zh-tw/wiki/enemies/#e-oculothorax","c":"敵人","i":"/assets/sprites/enemy_oculothorax.png"},{"n":"大地精魂","d":"發射石彈的遠程飛行者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_earth_wisp.png"},{"n":"風之精魂","d":"發出紅光並釋放衝擊波。這麼做並不會讓牠死掉。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_wind_wisp.png"},{"n":"處刑惡魔","d":"將巨劍向下猛插，接著是一記長距離突刺。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_executioner_demon.png"},{"n":"詛咒惡魔","d":"原地站定，朝前方射出詛咒光束。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_curse_demon.png"},{"n":"Tharnok 惡魔","d":"跳到你剛才站的位置，濺出火焰。","u":"/zh-tw/wiki/enemies/#e-tharnok","c":"敵人","i":"/assets/sprites/enemy_tharnok_demon.png"},{"n":"燃燒骷髏","d":"飛行追擊者。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_burning_skull.png"},{"n":"Alkara 惡魔","d":"飛行施法者，交替發射火球與俯衝。","u":"/zh-tw/wiki/enemies/#e-alkara","c":"敵人","i":"/assets/sprites/enemy_alkara_demon.png"},{"n":"惡魔地雷","d":"漂浮的地雷，會越來越紅，直到爆炸。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_demon_mine.png"},{"n":"巨型骷髏","d":"每分鐘一隻。懸停在你上方往下噴火。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_large_skull.png"},{"n":"亡魂","d":"亡魂大軍（第 10 分鐘之後）中唯一的敵人，會被染成目前等級的顏色。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_lost_soul.png"},{"n":"盜賊哥布林","d":"每隔幾分鐘從地底冒出來逃跑。每次擊中都會掉落金幣或紅寶石；殺死牠會讓剩下的財寶一口氣爆出來。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_goblin_thief.png"},{"n":"Wendigo","d":"岩石與冰雪中挑戰雕像的挑戰敵人。從一道光柱中降下。","u":"/zh-tw/wiki/enemies/#e-wendigo","c":"敵人","i":"/assets/sprites/enemy_wendigo.png"},{"n":"魚人","d":"苔蘚與沙漠中的挑戰敵人。用爪子攻擊，並以弧線拋出水球。","u":"/zh-tw/wiki/enemies/#e-x","c":"敵人","i":"/assets/sprites/enemy_fishman.png"},{"n":"ExperimentZ","d":"鮮血與火山中的挑戰敵人。從很遠的地方朝你撲撞。","u":"/zh-tw/wiki/enemies/#e-experimentz","c":"敵人","i":"/assets/sprites/enemy_experimentz.png"}]